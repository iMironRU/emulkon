	ДобавитьКоманду(Шаги, "ДисплейПокупателя", "DisplayText", ВМассив(Ws + Символы.ПС + "ИТОГО 111.00"), "", "", "ВывестиСтрокуНаДисплейПокупателя");
	ДобавитьПоиск(Шаги, "ДисплейПокупателя");
	ДобавитьУправление(Шаги, "ДисплейПокупателя", "текст на дисплее", "GET", "/control/v1/devices", "", "ИТОГО 111.00");
