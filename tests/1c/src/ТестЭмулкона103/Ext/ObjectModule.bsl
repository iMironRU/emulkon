	Шаги.Добавить(Элемент);
КонецПроцедуры

// Общие параметры чека из конструкторов БПО: одна позиция без НДС, одна оплата; организация — первая в базе.
Функция ЧекБПО(ТипРасчета, ТипОплаты, Количество, Цена)
	Чек = МенеджерОборудованияКлиентСервер.ПараметрыОперацииФискализацииЧека();
	Чек.ТипРасчета = Перечисления.ТипыРасчетаДенежнымиСредствами[ТипРасчета];
	Выборка = Справочники.Организации.Выбрать();
	Если Выборка.Следующий() Тогда
		Чек.Организация = Выборка.Ссылка;
	КонецЕсли;
	Позиция = МенеджерОборудованияКлиентСервер.ПараметрыФискальнойСтрокиЧека();
	Позиция.Наименование = "ЭМУЛКОН ТЕСТ товар УТ";
	Позиция.Количество = Количество;
	Позиция.Цена = Цена;
	Позиция.ЦенаСоСкидками = Цена;
	Позиция.Сумма = Количество * Цена;
	Позиция.СуммаСкидок = 0;
	Чек.ПозицииЧека.Добавить(Позиция);
	Оплата = МенеджерОборудованияКлиентСервер.ПараметрыСтрокиОплаты();
	Оплата.ТипОплаты = Перечисления.ТипыОплатыККТ[ТипОплаты];
	Оплата.Сумма = Количество * Цена;
	Чек.ТаблицаОплат.Добавить(Оплата);
	Возврат Чек;
КонецФункции

Процедура ДобавитьККТ(Шаги, Команда, ВходныеПараметры, Содержит, Описание)
