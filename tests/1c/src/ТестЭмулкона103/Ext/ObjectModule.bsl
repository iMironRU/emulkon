	// Типы, которых нет в этой БПО, пропускаем — с записью в отчёте.
	Итог = Новый Массив;
	Пропущено = Новый Соответствие;
	Для Каждого Шаг Из Шаги Цикл
		Если ЗначениеЗаполнено(Шаг.Тип) И Устройства[Шаг.Тип] = Неопределено Тогда
			Если Пропущено[Шаг.Тип] = Неопределено Тогда
				Отчет.Добавить("ПРОПУСК " + Шаг.Тип + ": нет устройства (нет типа в БПО)");
				Пропущено.Вставить(Шаг.Тип, Истина);
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Если Шаг.Вид = "Найти" Или Шаг.Вид = "Управление" Тогда
			Шаг.Тип = ТипыЭмулкона()[Шаг.Тип];
		КонецЕсли;
		Итог.Добавить(Шаг);
	КонецЦикла;
	Возврат Итог;
КонецФункции

