Функция ВМассив(Значение1, Значение2 = Неопределено)
	Массив = Новый Массив;
	Массив.Добавить(Значение1);
	Если Значение2 <> Неопределено Тогда
		Массив.Добавить(Значение2);
	КонецЕсли;
	Возврат Массив;
КонецФункции

#КонецОбласти

#Область ControlAPI

Функция Управление(Метод, Путь, Тело = "")
	Адрес = СтрЗаменить(СтрЗаменить(Запуск.server, "http://", ""), "https://", "");
	Части = СтрРазделить(Адрес, ":");
	Соединение = Новый HTTPСоединение(Части[0], ?(Части.Количество() > 1, Число(Части[1]), 80), , , , 15);
	Запрос = Новый HTTPЗапрос(Путь);
	Запрос.Заголовки.Вставить("Content-Type", "application/json");
	Если ЗначениеЗаполнено(Тело) Тогда
		Запрос.УстановитьТелоИзСтроки(СтрЗаменить(Тело, "{ws}", Запуск.workstation), КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	КонецЕсли;
	Ответ = Соединение.ВызватьHTTPМетод(Метод, Запрос);
	Текст = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	Данные = Неопределено;
	Если СтрНачинаетсяС(СокрЛ(Текст), "{") Тогда
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Текст);
		Данные = ПрочитатьJSON(Чтение, Истина);
	КонецЕсли;
	Возврат Новый Структура("Код, Текст, Данные", Ответ.КодСостояния, Текст, Данные);
КонецФункции

#КонецОбласти

#Область Подготовка

Функция РазобратьПараметрЗапуска(Параметр)
	Результат = Новый Структура("report, driver, server, workstation", "", "", "http://127.0.0.1:8737", "EMULKON-1C-UT103");
	Для Каждого Пара Из СтрРазделить(Параметр, ";", Ложь) Цикл
		Позиция = СтрНайти(Пара, "=");
		Если Позиция > 0 Тогда
			Результат.Вставить(СокрЛП(Лев(Пара, Позиция - 1)), СокрЛП(Сред(Пара, Позиция + 1)));
		КонецЕсли;
	КонецЦикла;
	Если Не ЗначениеЗаполнено(Результат.report) Тогда
		Результат.report = КаталогВременныхФайлов() + "emulkon-1c-report.txt";
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Как форма элемента «Драйверы оборудования» этой БПО при загрузке из файла: progid, имя и версия — из
// INFO.XML архива, сам архив — в ЗагруженныйДрайвер. В INFO.XML Эмулкона типов несколько — запись на тип.
Функция ПодготовитьДрайвер(ПутьАрхива)
	ДвоичныеДанные = Новый ДвоичныеДанные(ПутьАрхива);
	Файл = Новый Файл(ПутьАрхива);
	Каталог = КаталогВременныхФайлов() + "emulkon-ut103-" + Новый УникальныйИдентификатор + "\";
	Архив = Новый ЧтениеZipФайла(ПутьАрхива);
	Архив.Извлечь(Архив.Элементы.Найти("INFO.XML"), Каталог);
	Архив.Закрыть();
	Чтение = Новый ЧтениеXML;
	Чтение.ОткрытьФайл(Каталог + "INFO.XML");
	Пока Чтение.Прочитать() Цикл
		Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента И Чтение.Имя = "component" Тогда
			ProgID = Чтение.ЗначениеАтрибута("progid");
			Имя = Чтение.ЗначениеАтрибута("name");
			Версия = Чтение.ЗначениеАтрибута("version");
			ТипыСтрокой = Чтение.ЗначениеАтрибута("type");
		КонецЕсли;
	КонецЦикла;
	Чтение.Закрыть();
	УдалитьФайлы(Каталог);

	Драйверы = Новый Соответствие;
	Создано = 0;
	Обновлено = 0;
	Пропущено = Новый Массив;
	Хеш = ХешДанных(ДвоичныеДанные);
	Для Каждого Тип Из СтрРазделить(ТипыСтрокой, ",", Ложь) Цикл
		Тип = СокрЛП(Тип);
		ТипОборудования = МенеджерОборудованияВызовСервера.ПолучитьТипОборудования(Тип);
		Если Не ЗначениеЗаполнено(ТипОборудования) Тогда
			Пропущено.Добавить(Тип);
			Продолжить;
		КонецЕсли;
		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Д.Ссылка КАК Ссылка ИЗ Справочник.ДрайверыОборудования КАК Д
		|ГДЕ ВЫРАЗИТЬ(Д.ИдентификаторОбъекта КАК СТРОКА(200)) = &Ид И Д.ТипОборудования = &Тип И НЕ Д.ПометкаУдаления");
		Запрос.УстановитьПараметр("Ид", ProgID);
		Запрос.УстановитьПараметр("Тип", ТипОборудования);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Объект = Выборка.Ссылка.ПолучитьОбъект();
			Хранимые = Объект.ЗагруженныйДрайвер.Получить();
			Если ТипЗнч(Хранимые) = Тип("ДвоичныеДанные") И ХешДанных(Хранимые) = Хеш Тогда
				Драйверы.Вставить(Тип, Выборка.Ссылка);
				Продолжить;
			КонецЕсли;
			Обновлено = Обновлено + 1;
		Иначе
			Объект = Справочники.ДрайверыОборудования.СоздатьЭлемент();
			Объект.ТипОборудования = ТипОборудования;
			Объект.ИдентификаторОбъекта = ProgID;
			Создано = Создано + 1;
		КонецЕсли;
		Объект.Наименование = Имя;
		Объект.ВерсияДрайвера = Версия;
		Объект.ПоставляетсяДистрибутивом = Ложь; // в архиве MANIFEST.XML
		Объект.ЗагруженныйДрайвер = Новый ХранилищеЗначения(ДвоичныеДанные, Новый СжатиеДанных(5));
		Объект.ИмяФайлаДрайвера = Файл.Имя;
		Объект.Записать();
		Драйверы.Вставить(Тип, Объект.Ссылка);
	КонецЦикла;
	Описание = Имя + " " + Версия + ", " + ProgID + ", типов " + Драйверы.Количество() + ", новых записей " + Создано
		+ ", обновлено " + Обновлено + ?(Пропущено.Количество() = 0, "", ", нет в БПО: " + СтрСоединить(Пропущено, ", "));
	Местоположение = ?(Драйверы.Количество() = 0, "", ПолучитьНавигационнуюСсылку(Драйверы["ККТ"], "ЗагруженныйДрайвер"));
	Возврат Новый Структура("Описание, Драйверы, Местоположение", Описание, Драйверы, Местоположение);
КонецФункции

// Компонента ставится на клиент заранее, как «Установить драйвер» в форме драйвера. Установка показывает
// сообщение «успешно установлена» и ждёт OK: run.ps1 закрывает его по метке <report>.status.
Процедура УстановитьКомпоненту(Местоположение)
	Если ПодключитьВнешнююКомпоненту(Местоположение, "ЭмулконПроверка", ТипВнешнейКомпоненты.Native) Тогда
		Отчет.Добавить("УСТАНОВКА компонента уже установлена на клиенте");
		Возврат;
	КонецЕсли;
	Метка = Новый ЗаписьТекста(Запуск.report + ".status", КодировкаТекста.UTF8);
	Метка.ЗаписатьСтроку("УСТАНОВКА");
	Метка.Закрыть();
	УстановитьВнешнююКомпоненту(Местоположение);
	УдалитьФайлы(Запуск.report + ".status");
	Отчет.Добавить("УСТАНОВКА компонента установлена на клиент");
КонецПроцедуры

// Экземпляры «ЭМУЛКОН ТЕСТ <тип>» на рабочем месте сеанса; параметры — ключи P_<параметр драйвера>,
// их БПО передаёт драйверу через УстановитьПараметр перед Подключить.
Процедура ПодготовитьУстройства(Драйверы, РабочееМесто)
	Для Каждого Драйвер Из Драйверы Цикл
		Тип = Драйвер.Ключ;
		Если ТипыЭмулкона()[Тип] = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Имя = "ЭМУЛКОН ТЕСТ " + Тип;
		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 П.Ссылка КАК Ссылка ИЗ Справочник.ПодключаемоеОборудование КАК П
		|ГДЕ П.Наименование = &Имя И П.РабочееМесто = &РабочееМесто И НЕ П.ПометкаУдаления");
		Запрос.УстановитьПараметр("Имя", Имя);
		Запрос.УстановитьПараметр("РабочееМесто", РабочееМесто);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Объект = Выборка.Ссылка.ПолучитьОбъект();
		Иначе
			Объект = Справочники.ПодключаемоеОборудование.СоздатьЭлемент();
			Объект.Наименование = Имя;
			Объект.ТипОборудования = МенеджерОборудованияВызовСервера.ПолучитьТипОборудования(Тип);
			Объект.РабочееМесто = РабочееМесто;
		КонецЕсли;
		Объект.ДрайверОборудования = Драйвер.Значение;
		Объект.УстройствоИспользуется = Истина;
		Объект.Записать();
		Ссылка = Объект.Ссылка;

		Настройки = Новый Структура;
		Настройки.Вставить("P_ServerURL", Запуск.server);
		Настройки.Вставить("P_DeviceToken", "");
		Настройки.Вставить("P_WorkstationID", Запуск.workstation);
		Настройки.Вставить("P_TimeoutMs", 30000);
		Настройки.Вставить("P_AutoUpdate", Ложь);
		Настройки.Вставить("P_InstanceID", Строка(Ссылка.УникальныйИдентификатор()));
		Настройки.Вставить("P_InstanceName", Имя);
		Настройки.Вставить("P_Infobase", Метаданные.Синоним + " · " + ПутьБазы());
		Если Тип = "СчитывательМагнитныхКарт" Тогда
			// Без ПараметрыДорожек БПО не вырезает дорожку: код карты пуст (ОбработатьСобытие).
			Дорожки = Новый Массив;
			Для Номер = 1 По 3 Цикл
				Дорожки.Добавить(Новый Структура("НомерДорожки, Использовать, Префикс, Суффикс", Номер, Номер = 2, 0, ?(Номер = 2, 13, 0)));
			КонецЦикла;
			Настройки.Вставить("ПараметрыДорожек", Дорожки);
			Настройки.Вставить("P_Prefix", 0);
			Настройки.Вставить("P_Suffix", 13);
		КонецЕсли;
		Если Не Справочники.ПодключаемоеОборудование.СохранитьПараметрыУстройства(Ссылка, Настройки) Тогда
			ВызватьИсключение "не записаны параметры устройства «" + Имя + "»";
		КонецЕсли;
		Устройства.Вставить(Тип, Ссылка);
	КонецЦикла;
	ОбновитьПовторноИспользуемыеЗначения();
КонецПроцедуры

Функция ПутьБазы()
	Для Каждого Часть Из СтрРазделить(СтрокаСоединенияИнформационнойБазы(), ";", Ложь) Цикл
		Пара = СтрРазделить(Часть, "=");
		Если Пара.Количество() = 2 И ВРег(Пара[0]) = "FILE" Тогда
			Возврат СтрЗаменить(Пара[1], """", "");
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

Функция ХешДанных(Данные)
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(Данные);
	Возврат ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма);
КонецФункции

Процедура ЗаписатьОтчет()
	Текст = Новый ЗаписьТекста(Запуск.report, КодировкаТекста.UTF8);
	Для Каждого Строка Из Отчет Цикл
		Текст.ЗаписатьСтроку(Строка);
	КонецЦикла;
	Текст.Закрыть();
КонецПроцедуры

#КонецОбласти

#КонецЕсли
