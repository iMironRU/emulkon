// Прогон Эмулкона в УТ 10.3 (обычное приложение, БПО 3.1.10, старая схема подключения универсального
// драйвера — docs/bpo-requirements/versions.md). Формы нет: управляемую форму внешней обработки обычное
// приложение не открывает, а толстый клиент пропускает /Execute. Обработку запускает крючок модуля
// приложения тестовой копии базы (tests/1c/prepare-ut103.ps1): Начать(ПараметрЗапуска), затем Шаг() по
// обработчику ожидания, пока он не вернёт 0; внешние события устройств приходят в ВнешнееСобытие().
//
// Драйвер загружается в «Драйверы оборудования» так же, как «Загрузить драйвер из файла» этой БПО
// (ЗагруженныйДрайвер — архив, ИдентификаторОбъекта — progid из INFO.XML), по экземпляру на тип.
// Команды — синхронные, как у документов УТ 10.3: МенеджерОборудованияКлиент.ВыполнитьКоманду.

#Если ТолстыйКлиентОбычноеПриложение Тогда

Перем Отчет, Запуск, ИдКлиента, Устройства, ИДЭмулятора, Шаги, НомерШага, События, ОтметкаСобытий, СрокСобытия,
	Ошибок, Проверок, ДрайверыБПО, ККТНапрямую;

#Область Прогон

Процедура Начать(Параметр) Экспорт
	Отчет = Новый Массив;
	События = Новый Массив;
	ИДЭмулятора = Новый Соответствие;
	Устройства = Новый Соответствие;
	Ошибок = 0;
	Проверок = 0;
	ИдКлиента = Новый УникальныйИдентификатор;
	Запуск = РазобратьПараметрЗапуска(Параметр);
	Шаги = Новый Массив;
	НомерШага = 0;
	Попытка
		Система = Новый СистемнаяИнформация;
		Отчет.Добавить("СВЕДЕНИЯ " + Метаданные.Имя + " " + Метаданные.Версия + "; БПО "
			+ МенеджерОборудованияВызовСервера.ВерсияБиблиотеки() + "; пользователь " + ИмяПользователя()
			+ "; платформа " + Система.ВерсияПриложения);
		ЗаписатьОтчет();
		Драйвер = ПодготовитьДрайвер(Запуск.driver);
		Отчет.Добавить("ДРАЙВЕР " + Драйвер.Описание);
		УстановитьКомпоненту(Драйвер.Местоположение);
		// Рабочее место сеанса БПО заводит сама (по идентификатору клиента), как при первом подключении.
		МенеджерОборудованияКлиент.ОбновитьРабочееМестоКлиента();
		РабочееМесто = МенеджерОборудованияВызовСервера.РабочееМестоКлиента();
		ДрайверыБПО = Драйвер.Драйверы;
		ПодготовитьУстройства(Драйвер.Драйверы, РабочееМесто);
		Отчет.Добавить("УСТРОЙСТВА " + Устройства.Количество() + " на рабочем месте «" + РабочееМесто + "»");
		Шаги = ПостроитьШаги();
	Исключение
		Ошибка("подготовка", ОписаниеОшибки());
		Шаги = Новый Массив;
	КонецПопытки;
	ЗаписатьОтчет();
КонецПроцедуры

// Выполняет шаги подряд; возвращает паузу до следующего вызова в секундах (ждём событие) или 0 — конец.
Функция Шаг() Экспорт
	Пока НомерШага < Шаги.Количество() Цикл
		Шаг = Шаги[НомерШага];
		Если Шаг.Вид = "Событие" Тогда
			Если Не СобытиеПришло(Шаг) Тогда
				Возврат 1;
			КонецЕсли;
		Иначе
			ВыполнитьШаг(Шаг);
		КонецЕсли;
		НомерШага = НомерШага + 1;
		// Отчёт — после каждого шага: сбой платформы не должен стирать пройденное.
		ЗаписатьОтчет();
	КонецЦикла;
	Отчет.Добавить("ИТОГ шагов " + Проверок + ", ошибок " + Ошибок);
	ЗаписатьОтчет();
	Возврат 0;
КонецФункции

// Модуль приложения пересылает сюда все внешние события; разбирает их БПО, как формы УТ.
Процедура ВнешнееСобытие(Источник, Событие, Данные) Экспорт
	Если События = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Описание = Новый Структура("Источник, Событие, Данные", Источник, Событие, Данные);
	ОписаниеОшибки = "";
	Попытка
		Разобрано = МенеджерОборудованияКлиент.ПолучитьСобытиеОтУстройства(Описание, ОписаниеОшибки);
	Исключение
		Разобрано = Неопределено;
		ОписаниеОшибки = ОписаниеОшибки();
	КонецПопытки;
	Запись = Новый Структура("Событие, Данные, ИмяСобытия, Параметр", Событие, Данные, "", Неопределено);
	Если Разобрано <> Неопределено Тогда
		Запись.ИмяСобытия = Разобрано.ИмяСобытия;
		Запись.Параметр = Разобрано.Параметр;
	КонецЕсли;
	События.Добавить(Запись);
	Отчет.Добавить("     событие " + Событие + " от " + Источник + " → "
		+ ?(Разобрано = Неопределено, "БПО не разобрала: " + ОписаниеОшибки, Разобрано.ИмяСобытия + " " + Кратко(Разобрано.Параметр)));
КонецПроцедуры

Процедура ВыполнитьШаг(Шаг)
	Попытка
		Если Шаг.Вид = "Раздел" Тогда
			Отчет.Добавить("== " + Шаг.Описание);

		ИначеЕсли Шаг.Вид = "Подключить" Тогда
			ОписаниеОшибки = "";
			Попытка
				Подключено = МенеджерОборудованияКлиент.ПодключитьОборудованиеПоИдентификатору(ИдКлиента, Устройства[Шаг.Тип], ОписаниеОшибки);
			Исключение
				Подключено = Ложь;
				ОписаниеОшибки = ОписаниеОшибки();
			КонецПопытки;
			Если ЗначениеЗаполнено(Шаг.Ошибка) И Подключено Тогда
				Ошибка(Шаг.Описание, "ждали отказ «" + Шаг.Ошибка + "», а подключение прошло");
			ИначеЕсли ЗначениеЗаполнено(Шаг.Ошибка) И СтрНайти(ОписаниеОшибки, Шаг.Ошибка) = 0 Тогда
				Ошибка(Шаг.Описание, "ждали отказ «" + Шаг.Ошибка + "», получили: " + ОписаниеОшибки);
			ИначеЕсли ЗначениеЗаполнено(Шаг.Ошибка) Тогда
				Успех(Шаг.Описание, "отказ: " + Лев(СтрЗаменить(ОписаниеОшибки, Символы.ПС, " "), 200));
			ИначеЕсли Подключено Тогда
				Успех(Шаг.Описание, "");
			Иначе
				Ошибка(Шаг.Описание, ОписаниеОшибки);
			КонецЕсли;

		ИначеЕсли Шаг.Вид = "Команда" Или Шаг.Вид = "ККТНапрямую" Тогда
			ВыходныеПараметры = Неопределено;
			Если Шаг.Вид = "Команда" Тогда
				Результат = МенеджерОборудованияКлиент.ВыполнитьКоманду(Устройства[Шаг.Тип], Шаг.Команда, Шаг.Параметры, ВыходныеПараметры);
			Иначе
				Результат = КомандаККТНапрямую(Шаг.Команда, Шаг.Параметры, ВыходныеПараметры);
			КонецЕсли;
			Текст = Кратко(ВыходныеПараметры);
			Если ЗначениеЗаполнено(Шаг.Ошибка) Тогда
				Если Результат Тогда
					Ошибка(Шаг.Описание, "ждали отказ «" + Шаг.Ошибка + "», а команда прошла: " + Текст);
				ИначеЕсли СтрНайти(Текст, Шаг.Ошибка) = 0 Тогда
					Ошибка(Шаг.Описание, "ждали отказ «" + Шаг.Ошибка + "», получили: " + Текст);
				Иначе
					Успех(Шаг.Описание, "отказ: " + Текст);
				КонецЕсли;
			ИначеЕсли Не Результат Тогда
				Ошибка(Шаг.Описание, Текст);
			ИначеЕсли ЗначениеЗаполнено(Шаг.Содержит) И СтрНайти(Текст, Шаг.Содержит) = 0 Тогда
				Ошибка(Шаг.Описание, "в ответе нет «" + Шаг.Содержит + "»: " + Лев(Текст, 300));
			Иначе
				Успех(Шаг.Описание, Лев(Текст, 200));
			КонецЕсли;

		ИначеЕсли Шаг.Вид = "Найти" Тогда
			Ответ = Управление("GET", "/control/v1/devices");
			Найдено = "";
			Сведения = Неопределено;
			Для Каждого Устройство Из Ответ.Данные["devices"] Цикл
				Если Устройство["workstation_id"] = Запуск.workstation И Устройство["type"] = Шаг.Тип
					И Устройство["keyed_by"] = "instance" Тогда
					Найдено = Устройство["device_id"];
					Сведения = Устройство;
				КонецЕсли;
			КонецЦикла;
			ИДЭмулятора.Вставить(Шаг.Тип, Найдено);
			Если ЗначениеЗаполнено(Найдено) Тогда
				Успех(Шаг.Описание, Найдено + " — экземпляр «" + Сведения["instance_name"] + "», база «" + Сведения["infobase"] + "»");
			Иначе
				Ошибка(Шаг.Описание, "нет устройства " + Шаг.Тип + " рабочего места " + Запуск.workstation);
			КонецЕсли;

		ИначеЕсли Шаг.Вид = "Управление" Тогда
			ОтметкаСобытий = События.Количество();
			СрокСобытия = Неопределено;
			Путь = СтрЗаменить(СтрЗаменить(Шаг.Путь, "{id}", ИДЭмулятора[Шаг.Тип]), "{ws}", Запуск.workstation);
			Ответ = Управление(Шаг.Метод, Путь, Шаг.Тело);
			Если Ответ.Код < 200 Или Ответ.Код >= 300 Тогда
				Ошибка(Шаг.Описание, "HTTP " + Ответ.Код + " " + Лев(Ответ.Текст, 300));
			ИначеЕсли ЗначениеЗаполнено(Шаг.Содержит) И СтрНайти(Ответ.Текст, Шаг.Содержит) = 0 Тогда
				Ошибка(Шаг.Описание, "в ответе нет «" + Шаг.Содержит + "»: " + Лев(Ответ.Текст, 300));
			Иначе
				Успех(Шаг.Описание, "");
			КонецЕсли;

		ИначеЕсли Шаг.Вид = "Отключить" Тогда
			Неудачи = Новый Массив;
			Для Каждого Устройство Из Устройства Цикл
				ОписаниеОшибки = "";
				Если Не МенеджерОборудованияКлиент.ОтключитьОборудованиеПоИдентификатору(ИдКлиента, Устройство.Значение, ОписаниеОшибки) Тогда
					Неудачи.Добавить(Устройство.Ключ + ": " + ОписаниеОшибки);
				КонецЕсли;
			КонецЦикла;
			Если Неудачи.Количество() = 0 Тогда
				Успех(Шаг.Описание, "отключено устройств: " + Устройства.Количество());
			Иначе
				Ошибка(Шаг.Описание, СтрСоединить(Неудачи, "; "));
			КонецЕсли;
		КонецЕсли;
	Исключение
		Ошибка(Шаг.Описание, ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

// ККТ модулем драйвера БПО (ПодключаемоеОборудованиеУниверсальныйДрайверКлиент) в обход справочника:
// подключение списком БПО ломается на параметрах регистрации (см. ПостроитьШаги). Объект драйвера —
// как МенеджерОборудованияКлиент.ПолучитьОбъектДрайвера, параметры регистрации — конструктор БПО.
Функция КомандаККТНапрямую(Команда, ВходныеПараметры, ВыходныеПараметры)
	Модуль = ПодключаемоеОборудованиеУниверсальныйДрайверКлиент;
	Если Команда = "Подключить" Тогда
		ПодключитьВнешнююКомпоненту(ПолучитьНавигационнуюСсылку(ДрайверыБПО["ККТ"], "ЗагруженныйДрайвер"), "EmulkonDriver");
		Объект = Новый("AddIn.EmulkonDriver.EmulkonDriver");
		Параметры = МенеджерОборудованияВызовСервера.ПолучитьПараметрыУстройства(Устройства["ККТ"]);
		Параметры.Вставить("Идентификатор", Устройства["ККТ"]);
		ПараметрыПодключения = Новый Структура;
		ПараметрыПодключения.Вставить("ТипОборудования", "ККТ");
		ПараметрыПодключения.Вставить("ПараметрыРегистрации", МенеджерОборудованияКлиентСервер.ПараметрыРегистрацииККТ());
		ПараметрыПодключения.Вставить("ИдентификаторУстройства", Устройства["ККТ"]);
		ПараметрыПодключения.Вставить("СнятСПоддержки", Ложь);
		ККТНапрямую = Новый Структура("Объект, Параметры, ПараметрыПодключения", Объект, Параметры, ПараметрыПодключения);
		Возврат Модуль.ПодключитьУстройство(Объект, Параметры, ПараметрыПодключения, ВыходныеПараметры);
	ИначеЕсли ККТНапрямую = Неопределено Тогда
		ВыходныеПараметры = ВМассив(999, "ККТ не подключена");
		Возврат Ложь;
	ИначеЕсли Команда = "Отключить" Тогда
		Возврат Модуль.ОтключитьУстройство(ККТНапрямую.Объект, ККТНапрямую.Параметры, ККТНапрямую.ПараметрыПодключения, ВыходныеПараметры);
	КонецЕсли;
	Результат = Модуль.ВыполнитьКоманду(Команда, ВходныеПараметры, ВыходныеПараметры, ККТНапрямую.Объект,
		ККТНапрямую.Параметры, ККТНапрямую.ПараметрыПодключения);
	// Параметры регистрации БПО держит в справочнике (у УТ 10.3 он сломан) — берём из ответа ККТ, как
	// после регистрации: из них БПО читает версию ФФД, регистрационный номер и номер ФН для чека.
	Если Результат И Команда = "GetDataKKT" И ТипЗнч(ВыходныеПараметры) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(ККТНапрямую.ПараметрыПодключения.ПараметрыРегистрации, ВыходныеПараметры);
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Событие из БПО после действия на устройстве: Истина — шаг решён (успехом или ошибкой).
Функция СобытиеПришло(Шаг)
	Для Индекс = ОтметкаСобытий По События.ВГраница() Цикл
		Запись = События[Индекс];
		Значение = ?(ЗначениеЗаполнено(Запись.ИмяСобытия), Запись.Параметр, Запись.Данные);
		Если ТипЗнч(Значение) = Тип("Массив") И Значение.Количество() > 0 Тогда
			Значение = Значение[0]; // формат БПО: [код, [данные, …]]
		КонецЕсли;
		Если Совпадает(Значение, Шаг.Значение) Тогда
			Успех(Шаг.Описание, Запись.ИмяСобытия + " " + Кратко(Значение));
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Если СрокСобытия = Неопределено Тогда
		СрокСобытия = ТекущаяДата() + 10;
	ИначеЕсли ТекущаяДата() > СрокСобытия Тогда
		Ошибка(Шаг.Описание, "за 10 с не пришло событие со значением " + Шаг.Значение + "; событий: "
			+ (События.Количество() - ОтметкаСобытий));
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

// Ожидание: строка «~текст» — содержит текст; иначе — равно.
Функция Совпадает(Значение, Ожидание)
	Если ТипЗнч(Ожидание) = Тип("Строка") И СтрНачинаетсяС(Ожидание, "~") Тогда
		Возврат СтрНайти(Строка(Значение), Сред(Ожидание, 2)) > 0;
	КонецЕсли;
	Возврат Значение = Ожидание;
КонецФункции

Функция Кратко(Значение)
	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Части = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Части.Добавить(Кратко(Элемент));
		КонецЦикла;
		Возврат "[" + СтрСоединить(Части, ", ") + "]";
	ИначеЕсли ТипЗнч(Значение) = Тип("Структура") Тогда
		Части = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Части.Добавить(Элемент.Ключ + ": " + Кратко(Элемент.Значение));
		КонецЦикла;
		Возврат "{" + СтрСоединить(Части, ", ") + "}";
	КонецЕсли;
	Возврат СтрЗаменить(СтрЗаменить(Строка(Значение), Символы.ПС, "\n"), Символы.ВК, "\r");
КонецФункции

Процедура Успех(Описание, Подробности)
	Проверок = Проверок + 1;
	Отчет.Добавить("ОК   " + Описание + ?(ЗначениеЗаполнено(Подробности), " — " + Подробности, ""));
КонецПроцедуры

Процедура Ошибка(Описание, Подробности)
	Проверок = Проверок + 1;
	Ошибок = Ошибок + 1;
	Отчет.Добавить("ОШИБКА " + Описание + ": " + Подробности);
КонецПроцедуры

#КонецОбласти

#Область Сценарий

// Типы БПО и ключи моделей Эмулкона. Распознавания в БПО 3.1 нет.
Функция ТипыЭмулкона()
	Типы = Новый Соответствие;
	Типы.Вставить("ККТ", "kkt");
	Типы.Вставить("ПринтерЧеков", "receipt_printer");
	Типы.Вставить("ЭквайринговыйТерминал", "acquiring");
	Типы.Вставить("СканерШтрихкода", "scanner");
	Типы.Вставить("СчитывательМагнитныхКарт", "card_reader");
	Типы.Вставить("ЭлектронныеВесы", "scales");
	Типы.Вставить("ВесыСПечатьюЭтикеток", "label_scales");
	Типы.Вставить("ПринтерЭтикеток", "label_printer");
	Типы.Вставить("ДисплейПокупателя", "display");
	Типы.Вставить("ТерминалСбораДанных", "tsd");
	Типы.Вставить("СчитывательRFID", "rfid");
	Возврат Типы;
КонецФункции

Функция ПостроитьШаги()
	Шаги = Новый Массив;
	Ws = Запуск.workstation;

