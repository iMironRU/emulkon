// Прогон Эмулкона в настоящей конфигурации (Розница 2.3, БПО 3.2.9): обработка запускается
// с /Execute (tests/1c/run.ps1), загружает драйвер в «Драйверы оборудования», заводит по
// устройству каждого типа на текущее рабочее место, подключает их через БПО, выполняет команды
// и ловит события. Отчёт — в файл из ПараметрЗапуска («report=…;driver=…;server=…;workstation=…»).
//
// Команды идут через МенеджерОборудованияКлиент.НачатьВыполнениеКоманды — как у самой Розницы, —
// поэтому шаги выполняются цепочкой: следующий запускается из оповещения о завершении предыдущего.

&НаКлиенте
Перем Отчет, Запуск, ИдКлиента, Устройства, ИДЭмулятора, Шаги, НомерШага, События, ОтметкаСобытий,
	ОжиданиеСобытия, Ошибок, Проверок, ВыданныйТокен, ЗапросКМ, ЧекРМК, ЧекВОчереди, КассаУНФ, ВерсияБПО;

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Отчет = Новый Массив;
	События = Новый Массив;
	ИДЭмулятора = Новый Соответствие;
	Ошибок = 0;
	Проверок = 0;
	ИдКлиента = Новый УникальныйИдентификатор;
	ПодключитьОбработчикОжидания("Прогон", 0.5, Истина);
КонецПроцедуры

// События устройств ввода БПО сам никуда не пересылает (модуль приложения Розницы их не ловит):
// форма разбирает их через МенеджерОборудованияКлиент.ПолучитьСобытиеОтУстройства, как формы РМК.
&НаКлиенте
Процедура ВнешнееСобытие(Источник, Событие, Данные)
	Описание = Новый Структура("Источник, Событие, Данные", Источник, Событие, Данные);
	ОписаниеОшибки = "";
	Попытка
		Разобрано = МенеджерОборудованияКлиент.ПолучитьСобытиеОтУстройства(Описание, ОписаниеОшибки);
	Исключение
		Разобрано = Неопределено;
		ОписаниеОшибки = ОписаниеОшибки();
	КонецПопытки;
	Запись = Новый Структура("Источник, Событие, Данные, ИмяСобытия, Параметр", Источник, Событие, Данные, "", Неопределено);
	Если Разобрано <> Неопределено Тогда
		Запись.ИмяСобытия = Разобрано.ИмяСобытия;
		Запись.Параметр = Разобрано.Параметр;
	КонецЕсли;
	События.Добавить(Запись);
	Отчет.Добавить("     событие " + Событие + " от " + Источник + " → "
		+ ?(Разобрано = Неопределено, "БПО не разобрала: " + ОписаниеОшибки, Разобрано.ИмяСобытия + " " + Кратко(Разобрано.Параметр)));
КонецПроцедуры

#Область Прогон

&НаКлиенте
Асинх Процедура Прогон() Экспорт
	Попытка
		Запуск = РазобратьПараметрЗапуска();
		Отчет.Добавить("ЗАЩИТА " + ОтключитьПредупреждения());
		Отчет.Добавить("СВЕДЕНИЯ " + СведенияСервера());
		Отчет.Добавить("ТИПЫ " + ДоступныеТипыСтрокой());
		// mode=info (run.ps1 -Mode info): только сведения о конфигурации и её оборудовании, без прогона.
		Если Запуск.Свойство("mode") И Запуск.mode = "info" Тогда
			Завершить();
			Возврат;
		КонецЕсли;
		ВерсияБПО = ВерсияБПОСервер();
		ЗаписатьОтчет();

		ДанныеДрайвера = Новый ДвоичныеДанные(Запуск.driver);
		Адрес = ПоместитьВоВременноеХранилище(ДанныеДрайвера, УникальныйИдентификатор);
		Файл = Новый Файл(Запуск.driver);
		Драйвер = ПодготовитьДрайвер(Адрес, Файл.Имя);
		Отчет.Добавить("ДРАЙВЕР " + Драйвер.Описание);

		// Компонента ставится на клиент заранее: иначе БСП при первом подключении спросит
		// «Установить и продолжить?». Установка показывает сообщение «успешно установлена» и ждёт
		// OK, поэтому ставим только то, что ещё не подключается.
		Попытка
			Если Ждать ПодключитьВнешнююКомпонентуАсинх(Драйвер.Местоположение, "ЭмулконПроверка", ТипВнешнейКомпоненты.Native) Тогда
				Отчет.Добавить("УСТАНОВКА компонента уже установлена на клиенте");
			Иначе
				// Метка для run.ps1: сейчас 1С покажет «Внешняя компонента успешно установлена».
				Метка = Новый ЗаписьТекста(Запуск.report + ".status", КодировкаТекста.UTF8);
				Метка.ЗаписатьСтроку("УСТАНОВКА");
				Метка.Закрыть();
				Ждать УстановитьВнешнююКомпонентуАсинх(Драйвер.Местоположение);
				УдалитьФайлы(Запуск.report + ".status");
				Отчет.Добавить("УСТАНОВКА компонента установлена на клиент");
			КонецЕсли;
		Исключение
			Отчет.Добавить("УСТАНОВКА " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;

		РабочееМесто = МенеджерОборудованияКлиент.РабочееМестоКлиента();
		Устройства = ПодготовитьУстройства(Драйвер.Драйверы, РабочееМесто, Запуск.server, Запуск.workstation);
		ОбновитьПовторноИспользуемыеЗначения();
		Отчет.Добавить("УСТРОЙСТВА " + Устройства.Количество() + " на рабочем месте «" + РабочееМесто + "»");
	Исключение
		Ошибка("подготовка", ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Завершить();
		Возврат;
	КонецПопытки;

	Шаги = ПостроитьШаги();
	НомерШага = -1;
	СледующийШаг();
КонецПроцедуры

&НаКлиенте
Процедура СледующийШаг() Экспорт
	НомерШага = НомерШага + 1;
	// Отчёт — перед каждым шагом: непредвиденная ошибка платформы не должна стирать пройденное.
	Отчет.Добавить("…    шаг " + (НомерШага + 1) + " из " + Шаги.Количество());
	ЗаписатьОтчет();
	Отчет.Удалить(Отчет.ВГраница());
	Если НомерШага >= Шаги.Количество() Тогда
		Завершить();
		Возврат;
	КонецЕсли;
	ВыполнитьШаг(Шаги[НомерШага]);
КонецПроцедуры

&НаКлиенте
Процедура ДальшеПоШагам()
	ПодключитьОбработчикОжидания("СледующийШаг", 0.1, Истина);
КонецПроцедуры

&НаКлиенте
Асинх Процедура ВыполнитьШаг(Шаг)
	Попытка
		Если Шаг.Вид = "Раздел" Тогда
			Отчет.Добавить("== " + Шаг.Описание);
			ДальшеПоШагам();

		ИначеЕсли Шаг.Вид = "Подключить" Тогда
			Результаты = Ждать МенеджерОборудованияКлиент.ПодключениеОборудованияАсинх(ИдКлиента, Неопределено, Устройства[Шаг.Тип]);
			Если Результаты.Количество() = 0 Тогда
				Ошибка(Шаг.Описание, "БПО не нашла устройство для подключения");
			ИначеЕсли ЗначениеЗаполнено(Шаг.Ошибка) И Результаты[0].Результат Тогда
				Ошибка(Шаг.Описание, "ждали отказ «" + Шаг.Ошибка + "», а подключение прошло");
			ИначеЕсли ЗначениеЗаполнено(Шаг.Ошибка) И СтрНайти(Результаты[0].ОписаниеОшибки, Шаг.Ошибка) = 0 Тогда
				Ошибка(Шаг.Описание, "ждали отказ «" + Шаг.Ошибка + "», получили: " + Результаты[0].ОписаниеОшибки);
			ИначеЕсли ЗначениеЗаполнено(Шаг.Ошибка) Тогда
				Успех(Шаг.Описание, "отказ: " + Результаты[0].ОписаниеОшибки);
			ИначеЕсли Результаты[0].Результат Тогда
				Успех(Шаг.Описание, "ИДУстройства " + Результаты[0].ПодключенноеУстройство.ИДУстройства);
			Иначе
				Ошибка(Шаг.Описание, Результаты[0].ОписаниеОшибки);
			КонецЕсли;
			ДальшеПоШагам();

		ИначеЕсли Шаг.Вид = "Команда" Тогда
			Дополнительно = Новый Структура("ОставитьПодключенным", Истина);
			ПараметрыКоманды = МенеджерОборудованияКлиентСервер.ПараметрыВыполнениеКоманды(Шаг.Команда, Неопределено,
				Дополнительно, Ложь, Ложь);
			Оповещение = Новый ОписаниеОповещения("КомандаЗавершена", ЭтотОбъект, Шаг);
			МенеджерОборудованияКлиент.НачатьВыполнениеКоманды(Оповещение, ИдКлиента, Устройства[Шаг.Тип],
				Шаг.Параметры, ПараметрыКоманды);

		ИначеЕсли Шаг.Вид = "Найти" Тогда
			Ответ = Управление("GET", "/control/v1/devices");
			Найдено = "";
			Сведения = Неопределено;
			Для Каждого Устройство Из Ответ.Данные["devices"] Цикл
				Если Устройство["workstation_id"] = Запуск.workstation И Устройство["type"] = Шаг.Тип
					И Устройство["keyed_by"] = "instance" Тогда
					Найдено = Устройство["device_id"];
					Сведения = Устройство;
				КонецЕсли;
			КонецЦикла;
			ИДЭмулятора.Вставить(Шаг.Тип, Найдено);
			Если ЗначениеЗаполнено(Найдено) И Сведения["infobase"] <> ИмяБазы() Тогда
				Ошибка(Шаг.Описание, Найдено + ": база «" + Сведения["infobase"] + "», ждали «" + ИмяБазы() + "»");
			ИначеЕсли ЗначениеЗаполнено(Найдено) Тогда
				Успех(Шаг.Описание, Найдено + " — экземпляр «" + Сведения["instance_name"] + "», база «" + Сведения["infobase"] + "»");
			Иначе
				Ошибка(Шаг.Описание, "нет устройства " + Шаг.Тип + " рабочего места " + Запуск.workstation);
			КонецЕсли;
			ДальшеПоШагам();

		ИначеЕсли Шаг.Вид = "Управление" Тогда
			ОтметкаСобытий = События.Количество();
			Путь = СтрЗаменить(СтрЗаменить(Шаг.Путь, "{id}", ИДЭмулятора[Шаг.Тип]), "{ws}", Запуск.workstation);
			// «DELETE?» — любой ответ годится (уборка после прошлого прогона).
			ЛюбойОтвет = СтрЗаканчиваетсяНа(Шаг.Метод, "?");
			Ответ = Управление(СтрЗаменить(Шаг.Метод, "?", ""), Путь, СтрЗаменить(Шаг.Тело, "{ws}", Запуск.workstation));
			// Выданный токен рабочего места запоминаем для шага «Связь» — в отчёт он не пишется.
			Если ТипЗнч(Ответ.Данные) = Тип("Соответствие") И Ответ.Данные["token"] <> Неопределено Тогда
				ВыданныйТокен = Ответ.Данные["token"];
			КонецЕсли;
			Если ЛюбойОтвет Тогда
				Успех(Шаг.Описание, "HTTP " + Ответ.Код);
			ИначеЕсли Ответ.Код >= 200 И Ответ.Код < 300 Тогда
				Если ЗначениеЗаполнено(Шаг.Содержит) И СтрНайти(Ответ.Текст, Шаг.Содержит) = 0 Тогда
					Ошибка(Шаг.Описание, "в ответе нет «" + Шаг.Содержит + "»: " + Лев(Ответ.Текст, 300));
				Иначе
					Успех(Шаг.Описание, "");
				КонецЕсли;
			Иначе
				Ошибка(Шаг.Описание, "HTTP " + Ответ.Код + " " + Лев(Ответ.Текст, 300));
			КонецЕсли;
			ДальшеПоШагам();

		ИначеЕсли Шаг.Вид = "Фискальная" Тогда
			Шаг.Параметры = ПараметрыФискальнойОперации(Шаг);
			Оповещение = Новый ОписаниеОповещения("КомандаЗавершена", ЭтотОбъект, Шаг);
			Устройство = Устройства[Шаг.Тип];
			Если Шаг.Команда = "ОткрытьСмену" Тогда
				ОборудованиеЧекопечатающиеУстройстваКлиент.НачатьОткрытиеСменыНаФискальномУстройстве(Оповещение, ИдКлиента, Устройство, Шаг.Параметры);
			ИначеЕсли Шаг.Команда = "ЗакрытьСмену" Тогда
				ОборудованиеЧекопечатающиеУстройстваКлиент.НачатьЗакрытиеСменыНаФискальномУстройстве(Оповещение, ИдКлиента, Устройство, Шаг.Параметры);
			ИначеЕсли Шаг.Команда = "КартаСЧеком" Тогда
				Пакет = ОборудованиеЧекопечатающиеУстройстваКлиент.ПараметрыФискализацияЧекаСОплатойКартой();
				Пакет.ПараметрыФискализацииЧека = Шаг.Параметры;
				Сумма = Шаг.Значение.Количество * Шаг.Значение.Цена;
				ОперацияЭквайринга = ОборудованиеПлатежныеСистемыКлиентСервер.ПараметрыВыполненияЭквайринговойОперации();
				ОперацияЭквайринга.ТипТранзакции = "AuthorizeSales";
				ОперацияЭквайринга.СуммаОперации = Сумма;
				ОперацияЭквайринга.СуммаСобственныхСредств = Сумма;
				Пакет.ПараметрыВыполненияЭквайринговойОперации = ОперацияЭквайринга;
				Дополнительно = МенеджерОборудованияКлиентСервер.ДополнительныеПараметрыОперации(Истина);
				Если БПОНеНиже(3, 3) Тогда
					// БПО 3.3: асинхронная функция, отказ банка — в результате. Ждём её сами, чтобы ошибка
					// внутри пакета попала в отчёт, а не в окно «непредвиденной ошибки».
					Модуль = ОбщегоНазначенияКлиент.ОбщийМодуль("ОборудованиеЧекопечатающиеУстройстваКлиент");
					// Дополнительные параметры БПО 3.2 (ОставитьПодключенным) новой функции не нужны.
					Попытка
						Результат = Ждать Модуль.ФискализацияЧекаСОплатойКартойАсинх(ИдКлиента, Устройство,
							Устройства["ЭквайринговыйТерминал"], Пакет);
					Исключение
						Результат = Новый Структура("Результат, ОписаниеОшибки", Ложь,
							КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
					КонецПопытки;
					КомандаЗавершена(Результат, Шаг);
				Иначе
					// БПО 3.2: отказ терминала отдаётся сюда вместо вопроса кассиру — завершаем пакет без чека.
					Пакет.ОповещениеВопросПользователю = Новый ОписаниеОповещения("ОтказТерминалаВПакете", ЭтотОбъект);
					ОборудованиеЧекопечатающиеУстройстваКлиент.НачатьФискализациюЧекаСОплатойКартой(Оповещение, ИдКлиента, Устройство,
						Устройства["ЭквайринговыйТерминал"], Пакет, Дополнительно);
				КонецЕсли;
			ИначеЕсли Шаг.Команда = "ОтказКМ" Тогда
				ОборудованиеЧекопечатающиеУстройстваКлиент.НачатьПодтверждениеКМ(Оповещение, ИдКлиента, Устройство, Шаг.Параметры);
			ИначеЕсли Шаг.Команда = "Регистрация" Тогда
				ОборудованиеЧекопечатающиеУстройстваКлиент.НачатьОперациюФНДляФискальногоУстройства(Оповещение, ИдКлиента, Устройство, Шаг.Параметры);
			ИначеЕсли Шаг.Команда = "ОтчетX" Тогда
				ОборудованиеЧекопечатающиеУстройстваКлиент.НачатьФормированиеОтчетаБезГашения(Оповещение, ИдКлиента, Устройство, Шаг.Параметры);
			ИначеЕсли Шаг.Команда = "Коррекция" Тогда
				ОборудованиеЧекопечатающиеУстройстваКлиент.НачатьФормированиеЧекаКоррекцииНаФискальномУстройстве(Оповещение, ИдКлиента, Устройство, Шаг.Параметры);
			Иначе
				ОборудованиеЧекопечатающиеУстройстваКлиент.НачатьФискализациюЧекаНаФискальномУстройстве(Оповещение, ИдКлиента, Устройство, Шаг.Параметры);
			КонецЕсли;

		ИначеЕсли Шаг.Вид = "УНФ" Тогда
			Если Шаг.Команда = "Касса" Тогда
				КассаУНФ = КассаУНФСККТ(Устройства[Шаг.Тип]);
				Успех(Шаг.Описание, Строка(КассаУНФ));
			Иначе
				Итог = КассоваяСменаУНФ(КассаУНФ, Шаг.Команда = "ОткрытьСмену");
				Если Итог.Результат Тогда
					Успех(Шаг.Описание, Итог.Описание);
				Иначе
					Ошибка(Шаг.Описание, Итог.Описание);
				КонецЕсли;
			КонецЕсли;
			ДальшеПоШагам();

		ИначеЕсли Шаг.Вид = "ЧекУНФ" Тогда
			Данные = ПодготовитьЧекУНФ(КассаУНФ);
			ЧекРМК = Данные.Ссылка;
			Отчет.Добавить("     " + Данные.Сводка);
			Оповещение = Новый ОписаниеОповещения("ЧекУНФПробит", ЭтотОбъект, Шаг);
			ОборудованиеЧекопечатающиеУстройстваКлиент.НачатьФискализациюЧекаНаФискальномУстройстве(Оповещение, ИдКлиента,
				Устройства[Шаг.Тип], Данные.Параметры);

		ИначеЕсли Шаг.Вид = "ЧекРМК" Тогда
			Данные = ПодготовитьЧекРМК(Устройства[Шаг.Тип], МенеджерОборудованияКлиент.РабочееМестоКлиента());
			ЧекРМК = Данные.Ссылка;
			Отчет.Добавить("     " + Данные.Сводка);
			Данные.Параметры.Вставить("ПечатьИзФормыЧека", Истина);
			ЧекВОчереди = ОчередьЧековБПО().ДобавитьЧекВОчередьЧековККТ(Данные.Параметры);
			ОбщегоНазначенияКлиент.ОбщийМодуль("МенеджерОборудованияКлиент").ФискализацияЧековВОчереди(Ложь);
			ОжиданиеСобытия = Новый Структура("Шаг, Срок", Шаг, ТекущаяУниверсальнаяДатаВМиллисекундах() + 30000);
			ПодключитьОбработчикОжидания("ПроверитьЧекВОчереди", 0.5, Истина);

		ИначеЕсли Шаг.Вид = "ПроверкаКМ" Тогда
			Запрос = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПараметрыЗапросКМ();
			Запрос.КонтрольнаяМарка = КодМаркировкиBase64(Шаг.Значение.GTIN);
			Запрос.Количество = 1;
			Запрос.КодЕдиницыИзмерения = "0";
			Запрос.Наименование = "ЭМУЛКОН ТЕСТ маркированный товар";
			Запрос.ПланируемыйСтатусТовара = ОборудованиеЧекопечатающиеУстройстваКлиент.ПланируемыеСтатусыМаркированногоТовара()["ШтучныйТоварРеализован"];
			Проверка = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПараметрыПроверкиКМ();
			Проверка.ОжидатьПолученияОтветаПроверкиКМ = Истина;
			Проверка.ЗапросыКМ.Добавить(Запрос);
			Шаг.Параметры = Проверка;
			Оповещение = Новый ОписаниеОповещения("ПроверкаКМЗавершена", ЭтотОбъект, Шаг);
			ОборудованиеЧекопечатающиеУстройстваКлиент.НачатьПроверкуКМ(Оповещение, ИдКлиента, Устройства[Шаг.Тип], Проверка);

		ИначеЕсли Шаг.Вид = "УборкаСмены" Тогда
			Успех(Шаг.Описание, ЗакрытьВисящуюСменуБПО(Устройства[Шаг.Тип]));
			ДальшеПоШагам();

		ИначеЕсли Шаг.Вид = "Переподключить" Тогда
			Ждать МенеджерОборудованияКлиент.ОтключениеОборудованияАсинх(ИдКлиента, Неопределено, Устройства[Шаг.Тип]);
			Результаты = Ждать МенеджерОборудованияКлиент.ПодключениеОборудованияАсинх(ИдКлиента, Неопределено, Устройства[Шаг.Тип]);
			Если Результаты.Количество() > 0 И Результаты[0].Результат Тогда
				Успех(Шаг.Описание, "");
			Иначе
				Ошибка(Шаг.Описание, ?(Результаты.Количество() = 0, "БПО не нашла устройство", Результаты[0].ОписаниеОшибки));
			КонецЕсли;
			ДальшеПоШагам();

		ИначеЕсли Шаг.Вид = "Связь" Тогда
			// Новые параметры связи экземпляра: отключаем, записываем, следующий шаг подключает заново.
			Ждать МенеджерОборудованияКлиент.ОтключениеОборудованияАсинх(ИдКлиента, Неопределено, Устройства[Шаг.Тип]);
			Токен = СтрЗаменить(Шаг.Значение.Токен, "{token}", ?(ВыданныйТокен = Неопределено, "", ВыданныйТокен));
			Место = СтрЗаменить(Шаг.Значение.РабочееМесто, "{workstation}", Запуск.workstation);
			ЗаписатьПараметрыСвязи(Устройства[Шаг.Тип], Шаг.Тип, Запуск.server, Место, Токен, Шаг.Значение.База);
			ОбновитьПовторноИспользуемыеЗначения();
			Успех(Шаг.Описание, "токен: " + ?(ЗначениеЗаполнено(Токен), "…" + Прав(Токен, 4), "нет")
				+ ", рабочее место: " + ?(ЗначениеЗаполнено(Место), Место, "пусто"));
			ДальшеПоШагам();

		ИначеЕсли Шаг.Вид = "Событие" Тогда
			ОжиданиеСобытия = Новый Структура("Шаг, Срок", Шаг, ТекущаяУниверсальнаяДатаВМиллисекундах() + 10000);
			ПодключитьОбработчикОжидания("ПроверитьСобытие", 0.2, Истина);

		ИначеЕсли Шаг.Вид = "Отключить" Тогда
			// Без типов и без устройства БПО ничего не отключает (УстройстваДляОтключения):
			// отключаем каждое устройство по ссылке.
			Неудачи = Новый Массив;
			Отключено = 0;
			Для Каждого Устройство Из Устройства Цикл
				Результаты = Ждать МенеджерОборудованияКлиент.ОтключениеОборудованияАсинх(ИдКлиента, Неопределено, Устройство.Значение);
				Для Каждого Результат Из Результаты Цикл
					Если Результат.Результат Тогда
						Отключено = Отключено + 1;
					Иначе
						Неудачи.Добавить(Результат.ОписаниеОшибки);
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
			Если Неудачи.Количество() = 0 И Отключено = Устройства.Количество() Тогда
				Успех(Шаг.Описание, "отключено устройств: " + Отключено);
			ИначеЕсли Неудачи.Количество() = 0 Тогда
				Ошибка(Шаг.Описание, "отключено " + Отключено + " из " + Устройства.Количество());
			Иначе
				Ошибка(Шаг.Описание, СтрСоединить(Неудачи, "; "));
			КонецЕсли;
			ДальшеПоШагам();
		КонецЕсли;
	Исключение
		Ошибка(Шаг.Описание, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ДальшеПоШагам();
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗавершена(Результат, Шаг) Экспорт
	Попытка
		Если ЗначениеЗаполнено(Шаг.Ошибка) Тогда
			Если Результат.Результат Тогда
				Ошибка(Шаг.Описание, "ждали отказ «" + Шаг.Ошибка + "», а команда прошла");
			ИначеЕсли СтрНайти(Результат.ОписаниеОшибки, Шаг.Ошибка) = 0 Тогда
				Ошибка(Шаг.Описание, "ждали отказ «" + Шаг.Ошибка + "», получили: " + Результат.ОписаниеОшибки);
			Иначе
				Успех(Шаг.Описание, "отказ: " + Результат.ОписаниеОшибки);
			КонецЕсли;
		ИначеЕсли Не Результат.Результат Тогда
			Ошибка(Шаг.Описание, Результат.ОписаниеОшибки);
		Иначе
			Несовпадения = Новый Массив;
			Подробно = Новый Массив;
			Для Каждого Ожидание Из Шаг.Ждем Цикл
				Значение = Неопределено;
				Если Не Результат.Свойство(Ожидание.Ключ, Значение) Тогда
					Шаг.Параметры.Свойство(Ожидание.Ключ, Значение);
				КонецЕсли;
				Подробно.Добавить(Ожидание.Ключ + "=" + Лев(Кратко(Значение), 200));
				Если Не Совпадает(Значение, Ожидание.Значение) Тогда
					Несовпадения.Добавить(Ожидание.Ключ + ": ждали " + Ожидание.Значение + ", получили " + Лев(Кратко(Значение), 300));
				КонецЕсли;
			КонецЦикла;
			Если Несовпадения.Количество() = 0 Тогда
				Успех(Шаг.Описание, СтрСоединить(Подробно, "; "));
			Иначе
				Ошибка(Шаг.Описание, СтрСоединить(Несовпадения, "; "));
			КонецЕсли;
		КонецЕсли;
	Исключение
		Ошибка(Шаг.Описание, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	ДальшеПоШагам();
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьСобытие() Экспорт
	Шаг = ОжиданиеСобытия.Шаг;
	Для Индекс = ОтметкаСобытий По События.ВГраница() Цикл
		Запись = События[Индекс];
		Если Запись.ИмяСобытия = Шаг.Событие Тогда
			Значение = Запись.Параметр;
			Если ТипЗнч(Значение) = Тип("Массив") И Значение.Количество() > 0 Тогда
				Значение = Значение[0]; // старый формат БПО: [код, [данные, …]]
			КонецЕсли;
			Если Совпадает(Значение, Шаг.Значение) Тогда
				Успех(Шаг.Описание, Шаг.Событие + " " + Кратко(Значение));
			Иначе
				Ошибка(Шаг.Описание, "ждали " + Шаг.Значение + ", получили " + Кратко(Значение));
			КонецЕсли;
			ДальшеПоШагам();
			Возврат;
		КонецЕсли;
	КонецЦикла;
	Если ТекущаяУниверсальнаяДатаВМиллисекундах() > ОжиданиеСобытия.Срок Тогда
		Ошибка(Шаг.Описание, "за 10 с не пришло событие " + Шаг.Событие);
		ДальшеПоШагам();
		Возврат;
	КонецЕсли;
	// Повторяющийся обработчик чаще раза в секунду 1С не ставит: перезапускаем однократный.
	ПодключитьОбработчикОжидания("ПроверитьСобытие", 0.2, Истина);
КонецПроцедуры

// Ожидание: Истина — значение заполнено; строка «~текст» — содержит текст; иначе — равно.
&НаКлиенте
Функция Совпадает(Значение, Ожидание)
	Если Ожидание = Истина Тогда
		Возврат ЗначениеЗаполнено(Значение);
	ИначеЕсли ТипЗнч(Ожидание) = Тип("Строка") И СтрНачинаетсяС(Ожидание, "~") Тогда
		Возврат СтрНайти(Строка(Значение), Сред(Ожидание, 2)) > 0;
	КонецЕсли;
	Возврат Значение = Ожидание;
КонецФункции

&НаКлиенте
Функция Кратко(Значение)
	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Части = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Части.Добавить(Кратко(Элемент));
		КонецЦикла;
		Возврат "[" + СтрСоединить(Части, ", ") + "]";
	ИначеЕсли ТипЗнч(Значение) = Тип("Структура") Тогда
		Части = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Части.Добавить(Элемент.Ключ + ": " + Кратко(Элемент.Значение));
		КонецЦикла;
		Возврат "{" + СтрСоединить(Части, ", ") + "}";
	КонецЕсли;
	Возврат СтрЗаменить(СтрЗаменить(Строка(Значение), Символы.ПС, "\n"), Символы.ВК, "\r");
КонецФункции

&НаКлиенте
Процедура Успех(Описание, Подробности)
	Проверок = Проверок + 1;
	Отчет.Добавить("ОК   " + Описание + ?(ЗначениеЗаполнено(Подробности), " — " + Подробности, ""));
КонецПроцедуры

&НаКлиенте
Процедура Ошибка(Описание, Подробности)
	Проверок = Проверок + 1;
	Ошибок = Ошибок + 1;
	Отчет.Добавить("ОШИБКА " + Описание + ": " + Подробности);
КонецПроцедуры

&НаКлиенте
Процедура Завершить()
	Отчет.Добавить("ИТОГ шагов " + Проверок + ", ошибок " + Ошибок);
	ЗаписатьОтчет();
	ЗавершитьРаботуСистемы(Ложь);
КонецПроцедуры

#КонецОбласти

#Область Сценарий

// Типы оборудования: ключ модели Эмулкона и имя значения перечисления БПО.
&НаКлиенте
Функция ТипыЭмулкона()
	Типы = Новый Соответствие;
	Типы.Вставить("kkt", "ККТ");
	Типы.Вставить("receipt_printer", "ПринтерЧеков");
	Типы.Вставить("acquiring", "ЭквайринговыйТерминал");
	Типы.Вставить("scanner", "СканерШтрихкода");
	Типы.Вставить("card_reader", "СчитывательМагнитныхКарт");
	Типы.Вставить("scales", "ЭлектронныеВесы");
	Типы.Вставить("label_scales", "ВесыСПечатьюЭтикеток");
	Типы.Вставить("label_printer", "ПринтерЭтикеток");
	Типы.Вставить("display", "ДисплейПокупателя");
	Типы.Вставить("tsd", "ТерминалСбораДанных");
	Типы.Вставить("rfid", "СчитывательRFID");
	Типы.Вставить("recognizer", "УстройствоРаспознавания");
	Возврат Типы;
КонецФункции

&НаКлиенте
Функция ПостроитьШаги()
	Шаги = Новый Массив;
	Типы = ТипыЭмулкона();

	// ККТ: параметры и нефискальный документ.
	ДобавитьРаздел(Шаги, "ККТ");
	ДобавитьПодключение(Шаги, "kkt");
	ДобавитьКоманду(Шаги, "kkt", "GetDataKKT", Новый Структура, Новый Структура("ПараметрыККТXML", "~KKTSerialNumber=""EMU"));
	ДобавитьКоманду(Шаги, "kkt", "PrintText", Новый Структура("ТестовыеЧеки", ВМассив(ДокументПечати("EMULKON-1C-TEST ККТ"))));
	ДобавитьПоиск(Шаги, "kkt");
	ДобавитьУправление(Шаги, "kkt", "лента ККТ", "GET", "/control/v1/devices/{id}/prints", "", "EMULKON-1C-TEST");
	// Сценарий сбоя (ARCHITECTURE §7): один раз «нет бумаги» — ошибка доходит до БПО, следующая печать проходит.
	ДобавитьУправление(Шаги, "kkt", "убрать правило прошлого прогона", "DELETE?", "/control/v1/scenarios/emulkon-1c-test-paper");
	ДобавитьУправление(Шаги, "kkt", "сценарий: нет бумаги один раз", "POST", "/control/v1/scenarios",
		"{""id"": ""emulkon-1c-test-paper"", ""name"": ""Тест 1С: нет бумаги"", ""enabled"": true, ""limit"": 1,"
		+ " ""match"": {""workstation"": ""{ws}"", ""type"": ""kkt"", ""method"": ""PrintTextDocument""},"
		+ " ""action"": {""type"": ""error"", ""error_code"": 1, ""error_text"": ""Нет бумаги (сценарий)""}}");
	ДобавитьКоманду(Шаги, "kkt", "PrintText", Новый Структура("ТестовыеЧеки", ВМассив(ДокументПечати("EMULKON-1C-TEST сценарий"))),
		, "Нет бумаги (сценарий)", "печать при сбое из сценария");
	ДобавитьКоманду(Шаги, "kkt", "PrintText", Новый Структура("ТестовыеЧеки", ВМассив(ДокументПечати("EMULKON-1C-TEST после сбоя"))),
		, , "печать после сбоя");
	ДобавитьУправление(Шаги, "kkt", "сценарий сработал один раз", "GET", "/control/v1/scenarios", "", """fired"":1");
	ДобавитьУправление(Шаги, "kkt", "удалить правило", "DELETE", "/control/v1/scenarios/emulkon-1c-test-paper");

	// Фискальные операции — процедурами ОборудованиеЧекопечатающиеУстройстваКлиент, как в РМК:
	// БПО сама собирает CheckPackage, открывает и закрывает смену (docs/models/kkt.md).
	ДобавитьРаздел(Шаги, "Фискальный чек (БПО)");
	ДобавитьСброс(Шаги, "сброс моделей: смена закрыта");
	ДобавитьФискальную(Шаги, "ОткрытьСмену", "открытие смены");
	ДобавитьФискальную(Шаги, "Чек", "продажа за наличные", "Приход", "Наличные", 2, 150);
	ДобавитьФискальную(Шаги, "Чек", "продажа по карте", "Приход", "Электронно", 1, 99.9);
	ДобавитьФискальную(Шаги, "Чек", "возврат за наличные", "Возврат", "Наличные", 1, 150);
	ДобавитьУправление(Шаги, "kkt", "чеки на ленте", "GET", "/control/v1/devices/{id}/prints", "", "ЭМУЛКОН ТЕСТ товар");
	// Документ «Чек ККМ» Розницы — как кнопка «Пробить чек» формы документа: данные из
	// Документы.ЧекККМ.ПодготовитьДанныеДляПробитияЧека, очередь чеков БПО, документ проводится.
	ЕстьЧекККМ = ЕстьЧекККМРозницы();
	Если ЕстьЧекККМ Тогда
		Шаги.Добавить(НовыйШаг("ЧекРМК", "kkt", "«Чек ККМ» Розницы через очередь чеков"));
	КонецЕсли;
	// Чек коррекции (PrintReceiptCorrection → ProcessCorrectionCheck): самостоятельно и по предписанию.
	ДобавитьКоррекцию(Шаги, "коррекция прихода самостоятельно", "");
	ДобавитьКоррекцию(Шаги, "коррекция прихода по предписанию", "ТЕСТ-1");
	// Сценарий ФНС «сторно» по пробитому «Чеку ККМ»: БПО находит его фискальную операцию.
	Если ЕстьЧекККМ Тогда
		ДобавитьКоррекцию(Шаги, "коррекция сторно по «Чеку ККМ»", "ТЕСТ-2");
		Шаги[Шаги.ВГраница()].Значение.Вставить("Сторно", Истина);
	КонецЕсли;
	ДобавитьУправление(Шаги, "kkt", "коррекции на ленте", "GET", "/control/v1/devices/{id}/prints", "", "ПО ПРЕДПИСАНИЮ ТЕСТ-1");
	ДобавитьФискальную(Шаги, "ОтчетX", "X-отчёт");
	ДобавитьФискальную(Шаги, "ЗакрытьСмену", "закрытие смены");
	ДобавитьУправление(Шаги, "kkt", "отчёт о закрытии смены на ленте", "GET", "/control/v1/devices/{id}/prints", "", """kind"":""close_shift""");

	// «Чек ККМ» УНФ — как кнопка «Пробить чек» формы: касса с ККТ, смена на ККТ и «Кассовая смена»,
	// данные Документы.ЧекККМ.ПодготовитьДанныеДляПробитияЧека, фискализация, проведение с номерами.
	Если ЕстьЧекККМУНФ() Тогда
		ДобавитьРаздел(Шаги, "«Чек ККМ» УНФ");
		ДобавитьСброс(Шаги, "сброс моделей: смена закрыта");
		Шаги.Добавить(НовыйШаг("УНФ", "kkt", "касса ККМ с ККТ Эмулкона"));
		Шаги[Шаги.ВГраница()].Команда = "Касса";
		ДобавитьФискальную(Шаги, "ОткрытьСмену", "открытие смены на ККТ");
		Шаги.Добавить(НовыйШаг("УНФ", "kkt", "кассовая смена УНФ открыта"));
		Шаги[Шаги.ВГраница()].Команда = "ОткрытьСмену";
		Шаги.Добавить(НовыйШаг("ЧекУНФ", "kkt", "«Чек ККМ» УНФ пробит и проведён"));
		ДобавитьУправление(Шаги, "kkt", "чек УНФ на ленте", "GET", "/control/v1/devices/{id}/prints", "", """kind"":""check""");
		ДобавитьФискальную(Шаги, "ЗакрытьСмену", "закрытие смены на ККТ");
		Шаги.Добавить(НовыйШаг("УНФ", "kkt", "кассовая смена УНФ закрыта"));
		Шаги[Шаги.ВГраница()].Команда = "ЗакрытьСмену";
	КонецЕсли;

	// Маркировка через БПО (НачатьПроверкуКМ: RequestKM → GetProcessingKMResult → ConfirmKM) и ответы
	// ОИСМ по правилам km_rules эмулятора (docs/models/kkt.md, «Маркировка»).
	ДобавитьРаздел(Шаги, "Маркировка (БПО)");
	ДобавитьУправление(Шаги, "kkt", "правила ОИСМ по коду", "PUT", "/control/v1/devices/{id}/state",
		"{""km_result"": ""valid"", ""km_rules"": [{""title"": ""Тест: некорректный"", ""contains"": ""0104600000000027"", ""result"": ""invalid""},"
		+ " {""title"": ""Тест: приостановлен"", ""contains"": ""0104600000000034"", ""result"": ""suspended""}]}");
	ДобавитьФискальную(Шаги, "ОткрытьСмену", "открытие смены");
	ДобавитьПроверкуКМ(Шаги, "КМ без правила — ОИСМ подтверждает", "0104600000000010", Истина);
	ДобавитьФискальную(Шаги, "Чек", "продажа маркированного товара", "Приход", "Наличные", 1, 120, , , "0104600000000010");
	ДобавитьУправление(Шаги, "kkt", "КМ в чеке на ленте", "GET", "/control/v1/devices/{id}/prints", "", "[М] ЭМУЛКОН ТЕСТ товар");
	// Отклонённый код кассир убирает: ConfirmKM(…, 1). Без этого БПО перед следующим RequestKM или чеком
	// сама шлёт ConfirmKM(…, 0) — «к продаже» (ПодключаемоеОборудованиеДрайверКлиент.ЗапросКМ).
	ДобавитьПроверкуКМ(Шаги, "КМ по правилу «некорректен» — отказ", "0104600000000027", Ложь);
	ДобавитьФискальную(Шаги, "ОтказКМ", "отказ от КМ: ConfirmKM(…, 1)");
	ДобавитьУправление(Шаги, "kkt", "ConfirmKM с отказом в журнале", "GET",
		"/control/v1/journal?method=ConfirmKM&workstation_id={ws}&limit=2", "", """,1]");
	ДобавитьПроверкуКМ(Шаги, "КМ по правилу «приостановлен» — отказ", "0104600000000034", Ложь);
	ДобавитьФискальную(Шаги, "ОтказКМ", "отказ от КМ: ConfirmKM(…, 1)");
	ДобавитьФискальную(Шаги, "ЗакрытьСмену", "закрытие смены");
	ДобавитьУправление(Шаги, "kkt", "снять правила ОИСМ", "PUT", "/control/v1/devices/{id}/state", "{""km_rules"": []}");

	// Регистрация ККТ через БПО (OperationFN) и проверка СНО чека по регистрации: повтор — ошибка 11
	// эмулятора; чужую СНО отсекает уже БПО по данным регистрации из GetDataKKT, до драйвера.
	ДобавитьРаздел(Шаги, "Регистрация ККТ и СНО (БПО)");
	ДобавитьУправление(Шаги, "kkt", "снять регистрацию ККТ", "PUT", "/control/v1/devices/{id}/state", "{""fiscal"": false}");
	Шаги.Добавить(НовыйШаг("Переподключить", "kkt", "переподключить ККТ"));
	ДобавитьФискальную(Шаги, "Регистрация", "регистрация через БПО: только ОСН", , , , , "0");
	ДобавитьУправление(Шаги, "kkt", "отчёт о регистрации на ленте", "GET", "/control/v1/devices/{id}/prints", "", "СНО: 0");
	ДобавитьФискальную(Шаги, "Регистрация", "повторная регистрация — отказ", , , , , "0", "уже зарегистрирована");
	ДобавитьФискальную(Шаги, "ОткрытьСмену", "открытие смены");
	ДобавитьФискальную(Шаги, "Чек", "чек ОСН", "Приход", "Наличные", 1, 10, "ОСН");
	ДобавитьФискальную(Шаги, "Чек", "чек УСН доход — отказ", "Приход", "Наличные", 1, 10, "УСНДоход", "не зарегистрирована");
	ДобавитьФискальную(Шаги, "ЗакрытьСмену", "закрытие смены");
	ДобавитьСброс(Шаги, "сброс: регистрация по умолчанию");

	ДобавитьРаздел(Шаги, "Принтер чеков");
	ДобавитьПодключение(Шаги, "receipt_printer");
	ДобавитьКоманду(Шаги, "receipt_printer", "PrintText", Новый Структура("ТестовыеЧеки", ВМассив(ДокументПечати("EMULKON-1C-TEST PRINTER"))));
	ДобавитьПоиск(Шаги, "receipt_printer");
	ДобавитьУправление(Шаги, "receipt_printer", "лента принтера", "GET", "/control/v1/devices/{id}/prints", "", "EMULKON-1C-TEST PRINTER");

	// Терминал: оплата с автоодобрением, затем на экране терминала (отвечает «оператор» run.ps1).
	ДобавитьРаздел(Шаги, "Эквайринговый терминал");
	ДобавитьПодключение(Шаги, "acquiring");
	ДобавитьПоиск(Шаги, "acquiring");
	ДобавитьУправление(Шаги, "acquiring", "автоодобрение картой МИР", "PUT", "/control/v1/devices/{id}/state", "{""card_mode"": ""approve"", ""card"": ""mir""}");
	ДобавитьКоманду(Шаги, "acquiring", "AuthorizeSales", ОперацияТерминала(111), Новый Структура("ИсходящиеПараметрыXML, ТекстСлипЧека", "~RRNCode", "~ЭМУЛЯТОР"));
	ДобавитьУправление(Шаги, "acquiring", "экран терминала", "PUT", "/control/v1/devices/{id}/state", "{""card_mode"": ""interactive"", ""card_timeout_s"": 30}");
	ДобавитьКоманду(Шаги, "acquiring", "AuthorizeSales", ОперацияТерминала(222), Новый Структура("ИсходящиеПараметрыXML", "~RRNCode"), , "оплата: карту приложил оператор");
	ДобавитьКоманду(Шаги, "acquiring", "Settlement", Новый Структура, Новый Структура("ТекстСлипЧека", "~ЭМУЛЯТОР"));
	ДобавитьУправление(Шаги, "acquiring", "автоодобрение обратно", "PUT", "/control/v1/devices/{id}/state", "{""card_mode"": ""approve""}");

	// Оплата картой и чек одной операцией БПО (НачатьФискализациюЧекаСОплатойКартой): AuthorizeSales на
	// терминале, затем ProcessCheck на ККТ. Отказ банка (decline_above) — пакет без чека.
	ДобавитьРаздел(Шаги, "Оплата картой с фискализацией (БПО)");
	ДобавитьФискальную(Шаги, "ОткрытьСмену", "открытие смены");
	Если БПОНеНиже(3, 3) Тогда
		// Известная ошибка БПО 3.3.4.30: в пакете PayAndFiscalization серверная подготовка данных передаёт
		// подключение ККТ вместо обёртки подключений (ОборудованиеЧекопечатающиеУстройства.
		// ПодготовитьДанныеФискализацииСОплатой → ПриПодготовкеДанныхОперации) и падает до драйвера.
		// Шаг ждёт эту ошибку: когда 1С её исправит, он покраснеет — тогда вернуть полную проверку.
		ДобавитьФискальную(Шаги, "КартаСЧеком", "оплата картой и чек — известная ошибка БПО 3.3", "Приход", "Электронно", 1, 350, ,
			"ПодключениеОсновногоУстройства");
	Иначе
		ДобавитьФискальную(Шаги, "КартаСЧеком", "оплата картой и чек", "Приход", "Электронно", 1, 350);
		ДобавитьУправление(Шаги, "kkt", "чек с оплатой картой на ленте", "GET", "/control/v1/devices/{id}/prints", "", "ЭМУЛКОН ТЕСТ товар");
		ДобавитьУправление(Шаги, "acquiring", "банк отказывает выше 1000", "PUT", "/control/v1/devices/{id}/state", "{""decline_above"": 1000}");
		ДобавитьФискальную(Шаги, "КартаСЧеком", "отказ банка — чека нет", "Приход", "Электронно", 1, 1500, , "отклонена");
		ДобавитьУправление(Шаги, "acquiring", "порог отказа снят", "PUT", "/control/v1/devices/{id}/state", "{""decline_above"": 0}");
	КонецЕсли;
	ДобавитьФискальную(Шаги, "ЗакрытьСмену", "закрытие смены");

	ДобавитьРаздел(Шаги, "Сканер штрихкода");
	ДобавитьПодключение(Шаги, "scanner");
	ДобавитьПоиск(Шаги, "scanner");
	ДобавитьУправление(Шаги, "scanner", "скан EAN-13", "POST", "/control/v1/devices/{id}/actions/scan", "{""barcode"": ""4601234567893""}");
	ДобавитьСобытие(Шаги, "ScanData", "4601234567893");

	ДобавитьРаздел(Шаги, "Считыватель карт");
	ДобавитьПодключение(Шаги, "card_reader");
	ДобавитьПоиск(Шаги, "card_reader");
	ДобавитьУправление(Шаги, "card_reader", "провести дисконтную карту", "POST", "/control/v1/devices/{id}/actions/swipe", "{""card"": ""discount""}");
	ДобавитьСобытие(Шаги, "TracksData", "~7770000000017");

	ДобавитьРаздел(Шаги, "Электронные весы");
	ДобавитьПодключение(Шаги, "scales");
	ДобавитьПоиск(Шаги, "scales");
	ДобавитьУправление(Шаги, "scales", "вес 0,532 кг", "PUT", "/control/v1/devices/{id}/state", "{""weight"": 0.532, ""weight_mode"": ""manual""}");
	ДобавитьКоманду(Шаги, "scales", "GetWeight", Новый Структура, Новый Структура("Вес", 0.532));
	ДобавитьУправление(Шаги, "scales", "перегрузка 20 кг", "PUT", "/control/v1/devices/{id}/state", "{""weight"": 20}");
	ДобавитьКоманду(Шаги, "scales", "GetWeight", Новый Структура, , "Перегрузка");
	ДобавитьУправление(Шаги, "scales", "вес на экране весов", "PUT", "/control/v1/devices/{id}/state", "{""weight"": 0, ""weight_mode"": ""ask"", ""prompt_timeout_s"": 30}");
	ДобавитьКоманду(Шаги, "scales", "GetWeight", Новый Структура, Новый Структура("Вес", 0.777), , "взвешивание: вес ввёл оператор");
	ДобавитьУправление(Шаги, "scales", "вес вручную обратно", "PUT", "/control/v1/devices/{id}/state", "{""weight_mode"": ""manual""}");

	ДобавитьРаздел(Шаги, "Весы с печатью этикеток");
	ДобавитьПодключение(Шаги, "label_scales");
	ДобавитьКоманду(Шаги, "label_scales", "ClearBase", Новый Структура);

	ДобавитьРаздел(Шаги, "Принтер этикеток");
	ДобавитьПодключение(Шаги, "label_printer");
	ДобавитьКоманду(Шаги, "label_printer", "InitializePrinter", Новый Структура);

	ДобавитьРаздел(Шаги, "Дисплей покупателя");
	ДобавитьПодключение(Шаги, "display");
	ДобавитьКоманду(Шаги, "display", "DisplayText", Новый Структура("СтрокиТекста", "EMULKON-1C-TEST" + Символы.ПС + "ИТОГО 111.00"));
	ДобавитьПоиск(Шаги, "display");
	ДобавитьУправление(Шаги, "display", "текст на дисплее", "GET", "/control/v1/devices", "", "ИТОГО 111.00");
	ДобавитьКоманду(Шаги, "display", "ClearText", Новый Структура);

	ДобавитьРаздел(Шаги, "Терминал сбора данных");
	ДобавитьПодключение(Шаги, "tsd");
	ДобавитьПоиск(Шаги, "tsd");
	ДобавитьКоманду(Шаги, "tsd", "ClearTable", Новый Структура);
	ДобавитьУправление(Шаги, "tsd", "новый документ на ТСД", "POST", "/control/v1/devices/{id}/actions/clear_document", "{}");
	ДобавитьУправление(Шаги, "tsd", "отобрать товар", "POST", "/control/v1/devices/{id}/actions/collect", "{""barcode"": ""4601234567893"", ""quantity"": 2}");
	ДобавитьКоманду(Шаги, "tsd", "DownloadDocument", Новый Структура, Новый Структура("ДанныеЗагрузки", "~BarCodeBase64=""NDYwMTIzNDU2Nzg5Mw=="" Quantity=""2"""));

	ДобавитьРаздел(Шаги, "Считыватель RFID");
	ДобавитьПодключение(Шаги, "rfid");
	ДобавитьПоиск(Шаги, "rfid");
	ДобавитьКоманду(Шаги, "rfid", "OpenSessionRFID", Новый Структура);
	ДобавитьУправление(Шаги, "rfid", "положить метку", "POST", "/control/v1/devices/{id}/actions/add_tag", "{}");
	ДобавитьСобытие(Шаги, "RFID", Истина);
	ДобавитьКоманду(Шаги, "rfid", "CloseSessionRFID", Новый Структура);

	ДобавитьРаздел(Шаги, "Устройство распознавания");
	ДобавитьПодключение(Шаги, "recognizer");
	ДобавитьКоманду(Шаги, "recognizer", "Recognize", Новый Структура("Обучение, Варианты", Ложь, 5), Новый Структура("РаспознанныеТовары", "~1003"));

	// Токен рабочего места (docs/protocol.md §1.1) на сканере: место берётся из токена; место с
	// токеном без него не подключается; после отзыва — прежние параметры.
	ДобавитьРаздел(Шаги, "Токен рабочего места");
	ДобавитьУправление(Шаги, "scanner", "токен прошлого прогона", "DELETE?", "/control/v1/workstations/EMULKON-1C-TOKEN/token");
	ДобавитьУправление(Шаги, "scanner", "выдать токен месту EMULKON-1C-TOKEN", "POST", "/control/v1/workstations/EMULKON-1C-TOKEN/token", "", "emk_ws_");
	ДобавитьСвязь(Шаги, "scanner", "сканер: только токен, рабочее место пусто", "{token}", "");
	ДобавитьПодключение(Шаги, "scanner");
	ДобавитьУправление(Шаги, "scanner", "место из токена в журнале", "GET",
		"/control/v1/journal?method=session.open&workstation_id=EMULKON-1C-TOKEN&limit=1", "", """auth"":""workstation""");
	ДобавитьСвязь(Шаги, "scanner", "сканер: место с токеном, но без токена", "", "EMULKON-1C-TOKEN");
	Элемент = НовыйШаг("Подключить", "scanner", "подключение без токена — отказ");
	Элемент.Ошибка = "выдан токен";
	Шаги.Добавить(Элемент);
	ДобавитьУправление(Шаги, "scanner", "отозвать токен", "DELETE", "/control/v1/workstations/EMULKON-1C-TOKEN/token");
	// «База 1С» пуста — драйвер берёт базу из командной строки процесса 1С (/F"…", text.h).
	ДобавитьСвязь(Шаги, "scanner", "сканер: «База 1С» пуста", "", "{workstation}", "");
	ДобавитьПодключение(Шаги, "scanner");
	ДобавитьУправление(Шаги, "scanner", "база из командной строки 1С", "GET", "/control/v1/devices", "",
		"""infobase"":""" + СтрЗаменить(ПутьБазы(), "\", "\\") + """");
	ДобавитьСвязь(Шаги, "scanner", "сканер: прежние параметры", "", "{workstation}");
	ДобавитьПодключение(Шаги, "scanner");

	ДобавитьРаздел(Шаги, "Отключение");
	Шаги.Добавить(НовыйШаг("Отключить", "", "отключить всё оборудование"));

	// Разделы с типами, которых нет в конфигурации (МенеджерОборудования.ДоступныеТипыОборудования —
	// в БП 3.0 нет весов и считывателя карт), пропускаются целиком: устройств этих типов не заводим.
	Итог = Новый Массив;
	Раздел = Новый Массив;
	Для Индекс = 0 По Шаги.ВГраница() Цикл
		Шаг = Шаги[Индекс];
		Если Шаг.Вид = "Раздел" И Раздел.Количество() > 0 Тогда
			ДобавитьРазделЕслиДоступен(Итог, Раздел, Типы);
			Раздел = Новый Массив;
		КонецЕсли;
		Раздел.Добавить(Шаг);
	КонецЦикла;
	ДобавитьРазделЕслиДоступен(Итог, Раздел, Типы);

	Для Каждого Шаг Из Итог Цикл
		Если ЗначениеЗаполнено(Шаг.Тип) И Шаг.Вид <> "Найти" И Шаг.Вид <> "Управление" Тогда
			Шаг.Тип = Типы[Шаг.Тип];
		КонецЕсли;
	КонецЦикла;
	Возврат Итог;
КонецФункции

&НаКлиенте
Процедура ДобавитьРазделЕслиДоступен(Итог, Раздел, Типы)
	Для Каждого Шаг Из Раздел Цикл
		Если ЗначениеЗаполнено(Шаг.Тип) И Устройства[Типы[Шаг.Тип]] = Неопределено Тогда
			Отчет.Добавить("ПРОПУСК «" + Раздел[0].Описание + "»: тип " + Типы[Шаг.Тип] + " недоступен в конфигурации");
			Возврат;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Шаг Из Раздел Цикл
		Итог.Добавить(Шаг);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Функция НовыйШаг(Вид, Тип, Описание)
	Возврат Новый Структура("Вид, Тип, Описание, Команда, Параметры, Ждем, Ошибка, Метод, Путь, Тело, Содержит, Событие, Значение",
		Вид, Тип, Описание, "", Новый Структура, Новый Структура, "", "", "", "", "", "", Неопределено);
КонецФункции

&НаКлиенте
Процедура ДобавитьРаздел(Шаги, Описание)
	Шаги.Добавить(НовыйШаг("Раздел", "", Описание));
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьПодключение(Шаги, Тип)
	Шаги.Добавить(НовыйШаг("Подключить", Тип, "подключение через БПО"));
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьПоиск(Шаги, Тип)
	Шаги.Добавить(НовыйШаг("Найти", Тип, "устройство в Эмулконе"));
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьКоманду(Шаги, Тип, Команда, ПараметрыОперации, Ждем = Неопределено, ОжидаемаяОшибка = "", Описание = "")
	Элемент = НовыйШаг("Команда", Тип, ?(ЗначениеЗаполнено(Описание), Описание, Команда));
	Элемент.Команда = Команда;
	Элемент.Параметры = ПараметрыОперации;
	Если Ждем <> Неопределено Тогда
		Элемент.Ждем = Ждем;
	КонецЕсли;
	Элемент.Ошибка = ОжидаемаяОшибка;
	Шаги.Добавить(Элемент);
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьУправление(Шаги, Тип, Описание, Метод, Путь, Тело = "", Содержит = "")
	Элемент = НовыйШаг("Управление", Тип, Описание);
	Элемент.Метод = Метод;
	Элемент.Путь = Путь;
	Элемент.Тело = Тело;
	Элемент.Содержит = Содержит;
	Шаги.Добавить(Элемент);
КонецПроцедуры

// СНО: у чека — имя значения ТипыСистемНалогообложенияККТ, у регистрации — коды СНО через запятую.
&НаКлиенте
Процедура ДобавитьФискальную(Шаги, Операция, Описание, ТипРасчета = "", ТипОплаты = "", Количество = 0, Цена = 0,
	СНО = "", ОжидаемаяОшибка = "", GTIN = "")
	Элемент = НовыйШаг("Фискальная", "kkt", Описание);
	Элемент.Команда = Операция;
	Элемент.Значение = Новый Структура("ТипРасчета, ТипОплаты, Количество, Цена, СНО, GTIN", ТипРасчета, ТипОплаты, Количество, Цена, СНО, GTIN);
	Элемент.Ошибка = ОжидаемаяОшибка;
	Шаги.Добавить(Элемент);
КонецПроцедуры

// Чек коррекции прихода на 50 руб. наличными; Предписание пусто — коррекция самостоятельно.
&НаКлиенте
Процедура ДобавитьКоррекцию(Шаги, Описание, Предписание)
	ДобавитьФискальную(Шаги, "Коррекция", Описание, "Приход", "Наличные", 1, 50);
	Шаги[Шаги.ВГраница()].Значение.Вставить("Предписание", Предписание);
КонецПроцедуры

// Проверка КМ через БПО. Подтверждён — локальная проверка и ответ ОИСМ успешны и выполнен ConfirmKM.
&НаКлиенте
Процедура ДобавитьПроверкуКМ(Шаги, Описание, GTIN, Подтвержден)
	Элемент = НовыйШаг("ПроверкаКМ", "kkt", Описание);
	Элемент.Значение = Новый Структура("GTIN, Подтвержден", GTIN, Подтвержден);
	Шаги.Добавить(Элемент);
КонецПроцедуры

// Код маркировки GS1 (тестовый, не настоящий): GTIN, серийный номер, после GS — код проверки. В Base64,
// как его ждёт БПО.
&НаКлиенте
Функция КодМаркировкиBase64(GTIN)
	Код = GTIN + "21EMULKON" + Прав(GTIN, 4) + Символ(29) + "93TEST";
	Возврат ПолучитьBase64СтрокуИзДвоичныхДанных(ПолучитьДвоичныеДанныеИзСтроки(Код, КодировкаТекста.UTF8, Ложь));
КонецФункции

// Очередь чеков БПО 3.2 (Розница). В новой БПО (УНФ 3.0) её перенесли — раздел там не запускается,
// а обращение по имени не мешает модулю компилироваться.
&НаКлиенте
Функция ОчередьЧековБПО()
	Возврат ОбщегоНазначенияКлиент.ОбщийМодуль("ОборудованиеЧекопечатающиеУстройстваВызовСервера");
КонецФункции

// Как ПробитьЧекЗавершение формы «Чек ККМ» УНФ: номера смены и чека ККТ в документ и проведение.
&НаКлиенте
Процедура ЧекУНФПробит(Результат, Шаг) Экспорт
	Попытка
		Если Результат.Результат Тогда
			НомерСмены = ?(Результат.Свойство("НомерСменыККТ"), Результат.НомерСменыККТ, 0);
			НомерЧека = ?(Результат.Свойство("НомерЧекаККТ"), Результат.НомерЧекаККТ, 0);
			Успех(Шаг.Описание, "чек № " + НомерЧека + ", смена " + НомерСмены + "; " + ЗаписатьЧекУНФ(ЧекРМК, НомерСмены, НомерЧека));
		Иначе
			Ошибка(Шаг.Описание, Результат.ОписаниеОшибки);
		КонецЕсли;
	Исключение
		Ошибка(Шаг.Описание, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	ДальшеПоШагам();
КонецПроцедуры

// Статус чека в очереди БПО — как ПроверитьСтатусЧека формы «Чек ККМ».
&НаКлиенте
Процедура ПроверитьЧекВОчереди() Экспорт
	Шаг = ОжиданиеСобытия.Шаг;
	Попытка
		Статус = ОчередьЧековБПО().ПолучитьСтатусЧекаВОчереди(ЧекВОчереди);
		Если Статус.СтатусЧека = ПредопределенноеЗначение("Перечисление.СтатусЧекаККТВОчереди.Фискализирован") Тогда
			Успех(Шаг.Описание, "чек № " + Статус.НомерЧекаККМ + ", смена " + Статус.НомерСменыККМ + "; " + СостояниеЧекаРМК(ЧекРМК));
		ИначеЕсли Статус.СтатусЧека = ПредопределенноеЗначение("Перечисление.СтатусЧекаККТВОчереди.Ошибка") Тогда
			Ошибка(Шаг.Описание, Статус.ТекстОшибки);
			ОчередьЧековБПО().УдалитьЧекИзОчереди(ЧекРМК);
		ИначеЕсли ТекущаяУниверсальнаяДатаВМиллисекундах() > ОжиданиеСобытия.Срок Тогда
			Ошибка(Шаг.Описание, "за 30 с чек не фискализирован, статус в очереди: " + Статус.СтатусЧека);
			ОчередьЧековБПО().УдалитьЧекИзОчереди(ЧекРМК);
		Иначе
			ПодключитьОбработчикОжидания("ПроверитьЧекВОчереди", 0.5, Истина);
			Возврат;
		КонецЕсли;
	Исключение
		Ошибка(Шаг.Описание, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	ДальшеПоШагам();
КонецПроцедуры

&НаКлиенте
Процедура ОтказТерминалаВПакете(Результат, ДополнительныеПараметры) Экспорт
	ОборудованиеЧекопечатающиеУстройстваКлиент.НачатьФискализациюЧекаСОплатойКартой_ПродолжитьВыполнение(Ложь, Результат.КонтекстОперации);
КонецПроцедуры

&НаКлиенте
Процедура ПроверкаКМЗавершена(Результат, Шаг) Экспорт
	Попытка
		Итог = Неопределено;
		Если Результат.Свойство("РезультатыОпераций") И Результат.РезультатыОпераций.Количество() > 0 Тогда
			Итог = Результат.РезультатыОпераций[0];
		КонецЕсли;
		Если Итог = Неопределено Тогда
			Ошибка(Шаг.Описание, "нет результата проверки: " + Результат.ОписаниеОшибки);
		Иначе
			Подробно = "проверка " + Итог.ПроверкаКМ + ", подтверждение " + Итог.ПодтверждениеВыполнено
				+ ?(ЗначениеЗаполнено(Итог.ОписаниеОшибки), ", " + Итог.ОписаниеОшибки, "");
			Подтвержден = Итог.ПроверкаКМ И Итог.ПодтверждениеВыполнено;
			ЗапросКМ = Итог.ИдентификаторЗапроса;
			Если Подтвержден = Шаг.Значение.Подтвержден Тогда
				Успех(Шаг.Описание, Подробно);
			Иначе
				Ошибка(Шаг.Описание, "ждали " + ?(Шаг.Значение.Подтвержден, "подтверждение", "отказ") + ": " + Подробно);
			КонецЕсли;
		КонецЕсли;
	Исключение
		Ошибка(Шаг.Описание, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	ДальшеПоШагам();
КонецПроцедуры

// Параметры операции БПО для шага «Фискальная»: смена, отчёт или чек с одной позицией и одной оплатой.
&НаКлиенте
Функция ПараметрыФискальнойОперации(Шаг)
	Если Шаг.Команда = "ОтказКМ" Тогда
		Отказ = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПараметрыПодтверждениеКМ();
		Отказ.ИдентификаторЗапроса = ЗапросКМ;
		Отказ.Выбытие = Ложь;
		Возврат Отказ;
	ИначеЕсли Шаг.Команда = "Регистрация" Тогда
		Регистрация = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПараметрыОперацииФискализацииНакопителя();
		Регистрация.ТипОперации = 1;
		Регистрация.Кассир = "ЭМУЛКОН ТЕСТ кассир";
		Регистрация.ОрганизацияНазвание = "ООО «ТЕСТ ЭМУЛКОН»";
		Регистрация.ОрганизацияИНН = "7700000000";
		Регистрация.АдресПроведенияРасчетов = "г. Москва, ул. Тестовая, д. 1";
		Регистрация.МестоПроведенияРасчетов = "Касса 1 (тест)";
		Регистрация.КодыСистемыНалогообложения = Шаг.Значение.СНО;
		Регистрация.ВерсияФФДККТ = "1.2";
		Регистрация.ПродажаМаркированныхТоваров = Истина;
		Регистрация.АдресСайтаФНС = "www.nalog.gov.ru";
		Возврат Регистрация;
	ИначеЕсли Шаг.Команда <> "Чек" И Шаг.Команда <> "КартаСЧеком" И Шаг.Команда <> "Коррекция" Тогда
		Смена = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПараметрыОткрытияЗакрытияСмены();
		Смена.Кассир = "ЭМУЛКОН ТЕСТ кассир";
		Возврат Смена;
	КонецЕсли;
	Если Шаг.Команда = "Коррекция" Тогда
		Чек = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПараметрыОперацииЧекаКоррекции();
		// Сценарий БПО «неприменение ККТ»: расчёт прошёл мимо кассы. Сторно по ФНС требует ранее пробитый
		// чек документа базы (ОборудованиеЧекопечатающиеУстройства, ДанныеФискальнойОперации).
		Если Шаг.Значение.Свойство("Сторно") Тогда
			Чек.КорректируемыйДокумент = ЧекРМК;
			Чек.ДокументОснование = ЧекРМК;
		Иначе
			Чек.НеприменениеККТ = Истина;
			Чек.СформироватьЧекКоррекцииСторно = Ложь;
		КонецЕсли;
		Коррекция = Чек.ДанныеКоррекции;
		Коррекция.ТипКоррекции = ?(ЗначениеЗаполнено(Шаг.Значение.Предписание), 1, 0);
		Коррекция.НомерПредписания = Шаг.Значение.Предписание;
		Коррекция.ОписаниеКоррекции = "ЭМУЛКОН ТЕСТ коррекция";
		Коррекция.ДатаКоррекции = НачалоДня(ОбщегоНазначенияКлиент.ДатаСеанса()) - 86400;
	Иначе
		Чек = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПараметрыОперацииФискализацииЧека();
	КонецЕсли;
	Чек.Кассир = "ЭМУЛКОН ТЕСТ кассир";
	// Реквизиты пользователя ККТ — как в регистрации эмулятора (docs/models/kkt.md).
	Чек.ОрганизацияНазвание = "ООО «ТЕСТ ЭМУЛКОН»";
	Чек.ОрганизацияИНН = "7700000000";
	Если ЗначениеЗаполнено(Шаг.Значение.СНО) Тогда
		Чек.СистемаНалогообложения = ПредопределенноеЗначение("Перечисление.ТипыСистемНалогообложенияККТ." + Шаг.Значение.СНО);
	КонецЕсли;
	Чек.ТипРасчета = ?(Шаг.Значение.ТипРасчета = "Возврат",
		ПредопределенноеЗначение("Перечисление.ТипыРасчетаДенежнымиСредствами.ВозвратДенежныхСредств"),
		ПредопределенноеЗначение("Перечисление.ТипыРасчетаДенежнымиСредствами.ПриходДенежныхСредств"));
	Сумма = Шаг.Значение.Количество * Шаг.Значение.Цена;
	Позиция = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПараметрыФискальнойСтрокиЧека();
	Позиция.НомерСтрокиТовара = 1;
	Позиция.Наименование = "ЭМУЛКОН ТЕСТ товар";
	Позиция.Количество = Шаг.Значение.Количество;
	Позиция.Цена = Шаг.Значение.Цена;
	Позиция.ЦенаСоСкидками = Шаг.Значение.Цена;
	Позиция.Сумма = Сумма;
	Позиция.СтавкаНДС = 20;
	Позиция.СуммаНДС = Окр(Сумма * 20 / 120, 2);
	Позиция.ПризнакСпособаРасчета = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПризнакСпособаРасчетаПоКоду(4);
	Позиция.ПризнакПредметаРасчета = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПризнакПредметаРасчетаПоКоду(1);
	Позиция.КодЕдиницыИзмерения = "0";
	Если ЗначениеЗаполнено(Шаг.Значение.GTIN) Тогда
		Позиция.КонтрольнаяМарка = КодМаркировкиBase64(Шаг.Значение.GTIN);
	КонецЕсли;
	Чек.ПозицииЧека.Добавить(Позиция);
	Оплата = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПараметрыСтрокиОплаты(Сумма);
	Если Шаг.Значение.ТипОплаты = "Электронно" Тогда
		Оплата.ТипОплаты = ПредопределенноеЗначение("Перечисление.ТипыОплатыККТ.Электронно");
	КонецЕсли;
	Чек.ТаблицаОплат.Добавить(Оплата);
	Возврат Чек;
КонецФункции

// Сброс моделей и переподключение ККТ: БПО 3.3 запоминает смену и регистрацию из GetDataKKT при
