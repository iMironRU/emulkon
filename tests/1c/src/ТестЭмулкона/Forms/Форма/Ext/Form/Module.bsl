// ДанныеОперации эквайринга в том виде, в каком их читает ЭквайринговаяОперацияXML БПО, и
// OperationParameters (docs/bpo-requirements/pos-terminal.md).
&НаКлиенте
Функция ОперацияТерминала(Сумма)
	Текст = Формат(Сумма, "ЧДЦ=2; ЧРД=.; ЧГ=0");
	// Конструктор той БПО, где идёт прогон: БПО 3.3 читает поля, которых нет в 3.2 (ИдентификаторОперацииНаОборудовании).
	Операция = ОборудованиеПлатежныеСистемыКлиентСервер.ПараметрыВыполненияЭквайринговойОперации();
	Операция.РеквизитыКартыQR = "";
	Операция.СуммаОперации = Сумма;
	Операция.НомерМерчанта = 0;
	Операция.СуммаОригинальнойОперации = 0;
	Операция.Вставить("ВходящиеПараметрыXML", "<?xml version=""1.0"" encoding=""UTF-8""?><OperationParameters"
		+ " MerchantNumber=""0"" UseBiometrics=""0"" AuthorizationType=""0"" Amount=""" + Текст + """ AmountCash=""0"""
		+ " AmountOriginalTransaction=""0"" ElectronicCertificateAmount=""0"" ElectronicCertificateDiscount=""0"""
		+ " OwnFundsAmount=""" + Текст + """/>");
	Возврат Операция;
КонецФункции

#КонецОбласти

#Область ControlAPI

&НаКлиенте
Функция Управление(Метод, Путь, Тело = "")
	Адрес = СтрЗаменить(СтрЗаменить(Запуск.server, "http://", ""), "https://", "");
	Части = СтрРазделить(Адрес, ":");
	Соединение = Новый HTTPСоединение(Части[0], ?(Части.Количество() > 1, Число(Части[1]), 80), , , , 15);
	Запрос = Новый HTTPЗапрос(Путь);
	Запрос.Заголовки.Вставить("Content-Type", "application/json");
	Если ЗначениеЗаполнено(Тело) Тогда
		Запрос.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	КонецЕсли;
	Ответ = Соединение.ВызватьHTTPМетод(Метод, Запрос);
	Текст = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	Данные = Неопределено;
	Если СтрНачинаетсяС(СокрЛ(Текст), "{") Тогда
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Текст);
		Данные = ПрочитатьJSON(Чтение, Истина);
	КонецЕсли;
	Возврат Новый Структура("Код, Текст, Данные", Ответ.КодСостояния, Текст, Данные);
КонецФункции

#КонецОбласти

#Область Подготовка

&НаКлиенте
Функция РазобратьПараметрЗапуска()
	Результат = Новый Структура("report, driver, server, workstation", "", "", "http://127.0.0.1:8737", "EMULKON-1C-TEST");
	Для Каждого Пара Из СтрРазделить(ПараметрЗапуска, ";", Ложь) Цикл
		Позиция = СтрНайти(Пара, "=");
		Если Позиция > 0 Тогда
			Результат.Вставить(СокрЛП(Лев(Пара, Позиция - 1)), СокрЛП(Сред(Пара, Позиция + 1)));
		КонецЕсли;
	КонецЦикла;
	Если Не ЗначениеЗаполнено(Результат.report) Тогда
		Результат.report = КаталогВременныхФайлов() + "emulkon-1c-report.txt";
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Предупреждение «Разрешить открывать данный файл?» мешает прогону. Выключаем его для текущего
// пользователя — только в тестовой копии базы (решение владельца, 2026-10-08).
// Плюс штатная настройка БСП «решение по открытию внешних отчётов и обработок принято» — иначе
// при первом сеансе администратора БСП показывает модальное «Предупреждение безопасности»
// и прогон встаёт (issue #13). Метода может не быть (УТ 10.3, старые БПО) — тогда шаг пропускаем.
&НаСервереБезКонтекста
Функция ОтключитьПредупреждения()
	Если СтрНайти(СтрокаСоединенияИнформационнойБазы(), "EmulkonTest") = 0 Тогда
		Возврат "не трогаем: это не тестовая копия EmulkonTest";
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Пользователь = ПользователиИнформационнойБазы.ТекущийПользователь();
	Если Пользователь.ЗащитаОтОпасныхДействий.ПредупреждатьОбОпасныхДействиях Тогда
		Описание = Новый ОписаниеЗащитыОтОпасныхДействий;
		Описание.ПредупреждатьОбОпасныхДействиях = Ложь;
		Пользователь.ЗащитаОтОпасныхДействий = Описание;
		Пользователь.Записать();
	КонецЕсли;
	Результат = "предупреждения об опасных действиях выключены для " + Пользователь.Имя;
	Попытка
		Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.Пользователи") Тогда
			МодульПользователи = ОбщегоНазначения.ОбщийМодуль("Пользователи");
			МодульПользователи.УстановитьПравоОткрытияВнешнихОтчетовИОбработок(Истина);
			Результат = Результат + "; открытие внешних отчётов и обработок разрешено (БСП)";
		КонецЕсли;
	Исключение
		Результат = Результат + "; право БСП не выставлено: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция ВерсияБПОСервер()
	Попытка
		Возврат ОбновлениеИнформационнойБазы.ВерсияИБ("БиблиотекаПодключаемогоОборудования");
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции

// Версия БПО не ниже Старшая.Младшая (по первым двум числам «3.3.4.30»).
&НаКлиенте
Функция БПОНеНиже(Старшая, Младшая)
	Части = СтрРазделить(ВерсияБПО, ".");
	Если Части.Количество() < 2 Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Число(Части[0]) > Старшая Или (Число(Части[0]) = Старшая И Число(Части[1]) >= Младшая);
КонецФункции

&НаСервереБезКонтекста
Функция СведенияСервера()
	ВерсияБПО = "";
	Попытка
		ВерсияБПО = ОбновлениеИнформационнойБазы.ВерсияИБ("БиблиотекаПодключаемогоОборудования");
	Исключение
		ВерсияБПО = "? " + ОписаниеОшибки();
	КонецПопытки;
	Система = Новый СистемнаяИнформация;
	Возврат Метаданные.Имя + " " + Метаданные.Версия + "; БПО " + ВерсияБПО + "; пользователь " + ИмяПользователя()
		+ "; платформа " + Система.ВерсияПриложения;
КонецФункции

// Загрузка архива драйвера так же, как «Загрузить новый драйвер из файла» в списке драйверов
// (БПО 3.2.9, ДрайверыОборудования.ФормаСписка): компонента — в «Внешние компоненты», по записи
// «Драйверы оборудования» на каждый тип из INFO.XML. Повторный прогон записи не дублирует.
&НаСервереБезКонтекста
Функция ПодготовитьДрайвер(Адрес, ИмяФайла)
	УстановитьПривилегированныйРежим(Истина);
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(Адрес);
	Поиск = Новый Соответствие;
	Поиск.Вставить("Тип", Новый Структура("ИмяФайлаXML, ВыражениеXPath", "INFO.XML", "//drivers/component/@type"));
	Информация = ВнешниеКомпонентыБПО.ИнформацияОКомпонентеИзФайла(ДвоичныеДанные, Истина, Поиск);
	Если Не Информация.Разобрано Тогда
		ВызватьИсключение "архив драйвера не разобран: " + Информация.ОписаниеОшибки;
	КонецЕсли;
	Реквизиты = Информация.Реквизиты;

	Было = КомпонентыВБазе(ДвоичныеДанные);
	Загрузка = ВнешниеКомпонентыСлужебный.ПараметрыЗагрузки();
	Загрузка.Идентификатор = Реквизиты.Идентификатор;
	Загрузка.Наименование = Реквизиты.Наименование;
	Загрузка.Версия = Реквизиты.Версия;
	Загрузка.ИмяФайла = ИмяФайла;
	Загрузка.ОбновлятьСПортала1СИТС = Ложь;
	Загрузка.Данные = ДвоичныеДанные;
	ВнешниеКомпонентыСлужебный.ЗагрузитьКомпонентуИзДвоичныхДанных(Загрузка);
	Компонента = Справочники.ВнешниеКомпоненты.НайтиПоИдентификатору(Реквизиты.Идентификатор);
	Если Не ЗначениеЗаполнено(Компонента) Тогда
		ВызватьИсключение "компонента " + Реквизиты.Идентификатор + " не записана в «Внешние компоненты»";
	КонецЕсли;
	// БСП не перезаписывает компоненту той же версии, а сборки для прогона версию не меняют:
	// другой архив записываем так же, как ЗагрузитьКомпонентуИзДвоичныхДанных.
	Объект = Компонента.ПолучитьОбъект();
	Хранимые = Объект.ХранилищеКомпоненты.Получить();
	Если ТипЗнч(Хранимые) <> Тип("ДвоичныеДанные") Или ХешДанных(Хранимые) <> ХешДанных(ДвоичныеДанные) Тогда
		ЗаполнитьЗначенияСвойств(Объект, Реквизиты, , "Наименование, Версия, ИмяФайла");
		Объект.Версия = Реквизиты.Версия;
		Объект.ИмяФайла = ИмяФайла;
		Объект.ЦелевыеПлатформы = Новый ХранилищеЗначения(Реквизиты.ЦелевыеПлатформы, Новый СжатиеДанных(9));
		Объект.ДополнительныеСвойства.Вставить("ДвоичныеДанныеКомпоненты", ДвоичныеДанные);
		Объект.Записать();
	КонецЕсли;

	Драйверы = Новый Соответствие;
	Создано = 0;
	Типы = СтрРазделить(СтрЗаменить(Информация.ДополнительнаяИнформация["Тип"], ";", ","), ",", Ложь);
	Для Каждого Тип Из Типы Цикл
		Тип = СокрЛП(Тип);
		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Д.Ссылка КАК Ссылка ИЗ Справочник.ДрайверыОборудования КАК Д
		|ГДЕ ВЫРАЗИТЬ(Д.ИдентификаторОбъекта КАК СТРОКА(200)) = &Ид И Д.ТипОборудования = &Тип И НЕ Д.ПометкаУдаления");
		Запрос.УстановитьПараметр("Ид", Реквизиты.Идентификатор);
		Запрос.УстановитьПараметр("Тип", Перечисления.ТипыПодключаемогоОборудования[Тип]);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Драйверы.Вставить(Тип, Выборка.Ссылка);
			Продолжить;
		КонецЕсли;
		Создание = МенеджерОборудованияКлиентСервер.ПараметрыСозданияНовогоДрайвера();
		Создание.ТипОборудования = Тип;
		Создание.ИдентификаторОбъекта = Реквизиты.Идентификатор;
		Создание.Наименование = Реквизиты.Наименование;
		Создание.СпособПодключения = Перечисления.СпособПодключенияДрайвера.ИзИнформационнойБазы;
		Драйверы.Вставить(Тип, МенеджерОборудования.СоздатьДрайверОборудования(Создание));
		Создано = Создано + 1;
	КонецЦикла;

	Описание = Реквизиты.Наименование + " " + Реквизиты.Версия + ", идентификатор " + Реквизиты.Идентификатор
		+ ", типов " + Драйверы.Количество() + ", новых записей " + Создано
		+ Символы.ПС + "  компоненты в базе до загрузки: " + Было
		+ Символы.ПС + "  после: " + КомпонентыВБазе(ДвоичныеДанные);
	Возврат Новый Структура("Описание, Драйверы, Местоположение", Описание, Драйверы,
		ПолучитьНавигационнуюСсылку(Компонента, "ХранилищеКомпоненты"));
КонецФункции

// Путь файловой базы из строки соединения (File="…") — его драйвер берёт из командной строки 1С.
&НаСервереБезКонтекста
Функция ПутьБазы()
	Для Каждого Часть Из СтрРазделить(СтрокаСоединенияИнформационнойБазы(), ";", Ложь) Цикл
		Пара = СтрРазделить(Часть, "=");
		Если Пара.Количество() = 2 И ВРег(Пара[0]) = "FILE" Тогда
			Возврат СтрЗаменить(Пара[1], """", "");
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

// ИмяБазы — как база видна в веб-интерфейсе Эмулкона: конфигурация и путь или сервер/база.
&НаСервереБезКонтекста
Функция ИмяБазы()
	Соединение = СтрокаСоединенияИнформационнойБазы();
	Путь = "";
	Для Каждого Часть Из СтрРазделить(Соединение, ";", Ложь) Цикл
		Пара = СтрРазделить(Часть, "=");
		Если Пара.Количество() = 2 И (ВРег(Пара[0]) = "FILE" Или ВРег(Пара[0]) = "REF") Тогда
			Путь = Путь + ?(Путь = "", "", "/") + СтрЗаменить(Пара[1], """", "");
		ИначеЕсли Пара.Количество() = 2 И ВРег(Пара[0]) = "SRVR" Тогда
			Путь = СтрЗаменить(Пара[1], """", "") + ?(Путь = "", "", "/" + Путь);
		КонецЕсли;
	КонецЦикла;
	Возврат Метаданные.Синоним + " · " + Путь;
КонецФункции

// Записи «Внешние компоненты» Эмулкона (и «Эмукона» до 0.2.0): версия, дата, совпадает ли архив с прогоняемым.
&НаСервереБезКонтекста
Функция КомпонентыВБазе(НовыеДанные)
	Запрос = Новый Запрос("ВЫБРАТЬ К.Ссылка КАК Ссылка, К.Идентификатор КАК Идентификатор, К.Версия КАК Версия,
	|	К.ДатаВерсии КАК ДатаВерсии, К.Использование КАК Использование, К.ПометкаУдаления КАК ПометкаУдаления
	|ИЗ Справочник.ВнешниеКомпоненты КАК К
	|ГДЕ ВЫРАЗИТЬ(К.Идентификатор КАК СТРОКА(200)) ПОДОБНО ""%mu%kon%""");
	Эталон = ХешДанных(НовыеДанные);
	Строки = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Данные = Выборка.Ссылка.ХранилищеКомпоненты.Получить();
		Сравнение = ?(ТипЗнч(Данные) <> Тип("ДвоичныеДанные"), "архива нет",
			?(ХешДанных(Данные) = Эталон, "архив тот же", "архив другой, " + Данные.Размер() + " байт"));
		Строки.Добавить(Выборка.Идентификатор + " " + Выборка.Версия + " от " + Формат(Выборка.ДатаВерсии, "ДФ='дд.ММ.гггг ЧЧ:мм'")
			+ " (" + Выборка.Использование + ?(Выборка.ПометкаУдаления, ", удалена", "") + ", " + Сравнение + ")");
	КонецЦикла;
	Возврат ?(Строки.Количество() = 0, "нет", СтрСоединить(Строки, "; "));
КонецФункции

&НаСервереБезКонтекста
Функция ХешДанных(Данные)
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(Данные);
	Возврат ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма);
КонецФункции

// Устройства «ЭМУЛКОН ТЕСТ <тип>» на рабочем месте клиента. Параметры — как их пишет форма
// настройки БПО: ключи P_<имя параметра драйвера> (driver.cpp settingsXml), у считывателя карт
// ещё ПараметрыДорожек (БПО читает его без проверки). Автообновление в прогоне выключено.
&НаСервереБезКонтекста
Функция ПодготовитьУстройства(Драйверы, РабочееМесто, Сервер, РабочееМестоЭмулятора)
	УстановитьПривилегированныйРежим(Истина);
	Устройства = Новый Соответствие;
	Доступные = ДоступныеТипыБПО();
	Для Каждого Драйвер Из Драйверы Цикл
		Тип = Драйвер.Ключ;
		Если Доступные <> Неопределено И Доступные[Тип] = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Имя = "ЭМУЛКОН ТЕСТ " + Тип;
		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 П.Ссылка КАК Ссылка ИЗ Справочник.ПодключаемоеОборудование КАК П
		|ГДЕ П.Наименование = &Имя И П.РабочееМесто = &РабочееМесто И НЕ П.ПометкаУдаления");
		Запрос.УстановитьПараметр("Имя", Имя);
		Запрос.УстановитьПараметр("РабочееМесто", РабочееМесто);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Ссылка = Выборка.Ссылка;
			Объект = Ссылка.ПолучитьОбъект();
			Если Объект.ДрайверОборудования <> Драйвер.Значение Или Не Объект.УстройствоИспользуется Тогда
				Объект.ДрайверОборудования = Драйвер.Значение;
				Объект.УстройствоИспользуется = Истина;
				Объект.Записать();
			КонецЕсли;
		Иначе
			Создание = МенеджерОборудованияКлиентСервер.ПараметрыСозданияНовогоПодключаемогоОборудования();
			Создание.Наименование = Имя;
			Создание.ТипОборудования = Тип;
			Создание.ДрайверОборудования = Драйвер.Значение;
			Создание.РабочееМесто = РабочееМесто;
			Ссылка = МенеджерОборудования.СоздатьПодключаемоеОборудование(Создание);
		КонецЕсли;

		ЗаписатьПараметрыСвязи(Ссылка, Тип, Сервер, РабочееМестоЭмулятора, "");
		Устройства.Вставить(Тип, Ссылка);
	КонецЦикла;
	Возврат Устройства;
КонецФункции

// Имена типов, доступных в конфигурации (МенеджерОборудования.ДоступныеТипыОборудования — массив или список
// значений перечисления); Неопределено — функции нет, доступны все.
&НаСервереБезКонтекста
Функция ДоступныеТипыБПО()
	Попытка
		Список = МенеджерОборудования.ДоступныеТипыОборудования();
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Имена = Новый Соответствие;
	Для Каждого Элемент Из Список Цикл
		Значение = ?(ТипЗнч(Элемент) = Тип("ЭлементСпискаЗначений"), Элемент.Значение, Элемент);
		Имена.Вставить(XMLСтрока(Значение), Истина);
	КонецЦикла;
	Возврат Имена;
КонецФункции

// Сводка для docs/bpo-requirements/configurations.md: типы оборудования, которые конфигурация разрешает
// (в порядке перечисления БПО), и типы сетевого оборудования.
&НаСервереБезКонтекста
Функция ДоступныеТипыСтрокой()
	Доступные = ДоступныеТипыБПО();
	Если Доступные = Неопределено Тогда
		Возврат "все (нет ДоступныеТипыОборудования)";
	КонецЕсли;
	Имена = Новый Массив;
	Для Каждого Значение Из Метаданные.Перечисления.ТипыПодключаемогоОборудования.ЗначенияПеречисления Цикл
		Если Доступные[Значение.Имя] <> Неопределено Тогда
			Имена.Добавить(Значение.Имя);
		КонецЕсли;
	КонецЦикла;
	Сетевые = Новый Массив;
	Попытка
		Для Каждого Элемент Из МенеджерОборудования.ДоступныеТипыСетевогоОборудования() Цикл
			Сетевые.Добавить(XMLСтрока(?(ТипЗнч(Элемент) = Тип("ЭлементСпискаЗначений"), Элемент.Значение, Элемент)));
		КонецЦикла;
	Исключение
		Сетевые.Добавить("—");
	КонецПопытки;
	Возврат СтрСоединить(Имена, ", ") + "; сетевые: " + СтрСоединить(Сетевые, ", ");
КонецФункции

// «Чек ККМ» для пробития: копия пробитого чека продажи демо-базы (за наличные, без маркировки) на
// кассе «ЭМУЛКОН ТЕСТ касса» с нашей ККТ. Касса — копия кассы образца (магазин, тип, шаблоны).
&НаСервереБезКонтекста
Функция ПодготовитьЧекРМК(ККТ, РабочееМесто)
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ч.Ссылка КАК Ссылка ИЗ Документ.ЧекККМ КАК Ч
	|ГДЕ Ч.Проведен И Ч.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЧекККМ.Продажа)
	|	И НЕ Ч.ОперацияСДенежнымиСредствами
	|	И НЕ Ч.Комментарий ПОДОБНО ""ЭМУЛКОН ТЕСТ%""
	|	И Ч.Ссылка В (ВЫБРАТЬ О.Ссылка ИЗ Документ.ЧекККМ.Оплата КАК О
	|		ГДЕ О.ВидОплаты.ТипОплаты = ЗНАЧЕНИЕ(Перечисление.ТипыОплатЧекаККМ.Наличные))
	|	И НЕ Ч.Ссылка В (ВЫБРАТЬ О.Ссылка ИЗ Документ.ЧекККМ.Оплата КАК О
	|		ГДЕ О.ВидОплаты.ТипОплаты <> ЗНАЧЕНИЕ(Перечисление.ТипыОплатЧекаККМ.Наличные))
	|	И НЕ Ч.Ссылка В (ВЫБРАТЬ П.Ссылка ИЗ Документ.ЧекККМ.ПогашениеПодарочныхСертификатов КАК П)
	|	И НЕ Ч.Ссылка В (ВЫБРАТЬ Д.Ссылка ИЗ Документ.ЧекККМ.Подарки КАК Д)
	|	И НЕ Ч.Ссылка В (ВЫБРАТЬ К.Ссылка ИЗ Документ.ЧекККМ.КодыМаркировки КАК К)
	|	И НЕ Ч.Ссылка В (ВЫБРАТЬ А.Ссылка ИЗ Документ.ЧекККМ.АкцизныеМарки КАК А)
	|	И НЕ Ч.Ссылка В (ВЫБРАТЬ Т.Ссылка ИЗ Документ.ЧекККМ.Товары КАК Т ГДЕ Т.НеобходимостьВводаКодаМаркировки)
	|УПОРЯДОЧИТЬ ПО Ч.Дата УБЫВ");
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Всего,
		|	СУММА(ВЫБОР КОГДА Ч.Проведен ТОГДА 1 ИНАЧЕ 0 КОНЕЦ) КАК Проведено,
		|	СУММА(ВЫБОР КОГДА Ч.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЧекККМ.Продажа) ТОГДА 1 ИНАЧЕ 0 КОНЕЦ) КАК Продаж,
		|	СУММА(ВЫБОР КОГДА Ч.ОперацияСДенежнымиСредствами ТОГДА 1 ИНАЧЕ 0 КОНЕЦ) КАК ДенежныхОпераций
		|ИЗ Документ.ЧекККМ КАК Ч;
		|ВЫБРАТЬ КОЛИЧЕСТВО(РАЗЛИЧНЫЕ О.Ссылка) КАК СОплатой ИЗ Документ.ЧекККМ.Оплата КАК О;
		|ВЫБРАТЬ КОЛИЧЕСТВО(РАЗЛИЧНЫЕ К.Ссылка) КАК СМаркировкой ИЗ Документ.ЧекККМ.КодыМаркировки КАК К");
		Пакет = Запрос.ВыполнитьПакет();
		Счетчики = Пакет[0].Выбрать();
		Счетчики.Следующий();
		СОплатой = Пакет[1].Выгрузить()[0].СОплатой;
		СМаркировкой = Пакет[2].Выгрузить()[0].СМаркировкой;
		ВызватьИсключение СтрШаблон("нет образца «Чек ККМ»: всего %1, проведено %2, продаж %3, денежных операций %4, с оплатой %5, с маркировкой %6",
			Счетчики.Всего, Счетчики.Проведено, Счетчики.Продаж, Счетчики.ДенежныхОпераций, СОплатой, СМаркировкой);
	КонецЕсли;
	Образец = Выборка.Ссылка;

	// Розница допускает одну кассу на магазин, организацию и рабочее место — берём её, если есть.
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 К.Ссылка КАК Ссылка ИЗ Справочник.КассыККМ КАК К
	|ГДЕ К.Магазин = &Магазин И К.Владелец = &Владелец И К.РабочееМесто = &РабочееМесто И НЕ К.ПометкаУдаления
	|	И НЕ К.ТипКассы В (ЗНАЧЕНИЕ(Перечисление.ТипыКассККМ.ККМOffline), ЗНАЧЕНИЕ(Перечисление.ТипыКассККМ.ККМED))");
	Запрос.УстановитьПараметр("Магазин", Образец.КассаККМ.Магазин);
	Запрос.УстановитьПараметр("Владелец", Образец.КассаККМ.Владелец);
	Запрос.УстановитьПараметр("РабочееМесто", РабочееМесто);
	Выборка = Запрос.Выполнить().Выбрать();
	Касса = ?(Выборка.Следующий(), Выборка.Ссылка, Справочники["КассыККМ"].НайтиПоНаименованию("ЭМУЛКОН ТЕСТ касса", Истина));
	Если Касса.Пустая() Тогда
		НоваяКасса = Образец.КассаККМ.Скопировать();
		НоваяКасса.Наименование = "ЭМУЛКОН ТЕСТ касса";
	Иначе
		НоваяКасса = Касса.ПолучитьОбъект();
	КонецЕсли;
	НоваяКасса.ПодключаемоеОборудование = ККТ;
	НоваяКасса.ТипКассы = Перечисления["ТипыКассККМ"].ФискальныйРегистратор;
	НоваяКасса.ТипОборудования = Перечисления.ТипыПодключаемогоОборудования.ККТ;
	НоваяКасса.РабочееМесто = РабочееМесто;
	НоваяКасса.ИспользоватьБезПодключенияОборудования = Ложь;
	НоваяКасса.ОфлайнОборудование = Справочники["ОфлайнОборудование"].ПустаяСсылка();
	НоваяКасса.Записать();

	Чек = Образец.Скопировать();
	Чек.Дата = ТекущаяДатаСеанса();
	Чек.КассаККМ = НоваяКасса.Ссылка;
	Чек.СтатусЧекаККМ = Перечисления["СтатусыЧековККМ"].ПустаяСсылка();
	Чек.НомерЧекаККМ = 0;
	Чек.НомерСменыККМ = 0;
	Чек.Комментарий = "ЭМУЛКОН ТЕСТ: копия " + Образец;
	// При копировании чек очищает оплаты — переносим наличные образца.
	Если Чек.Оплата.Количество() = 0 Тогда
		Для Каждого Строка Из Образец.Оплата Цикл
			ЗаполнитьЗначенияСвойств(Чек.Оплата.Добавить(), Строка);
		КонецЦикла;
	КонецЕсли;
	Чек.Записать(РежимЗаписиДокумента.Запись);

	ДанныеДляЧека = ОбщегоНазначения.ОбщийМодуль("РозничныеПродажиКлиентСервер").СтруктураДанныхДляПробитияЧека();
	ДанныеДляЧека.ЧекККМСсылка = Чек.Ссылка;
	ДанныеДляЧека.НомерЧека = 1;
	ДанныеДляЧека.Объект = Чек;
	ДанныеДляЧека.НеПечататьБумажныйЧек = НоваяКасса.НеПечататьБумажныйЧек;
	ДанныеПробития = ОбщегоНазначения.ОбщийМодуль("РозничныеПродажиСервер").ПодготовитьДанныеДляПробитияЧека(ДанныеДляЧека);
	СуммаПозиций = 0;
	Для Каждого Позиция Из ДанныеПробития.ПозицииЧека Цикл
		Если Позиция.Свойство("Сумма") И ТипЗнч(Позиция.Сумма) = Тип("Число") Тогда
			СуммаПозиций = СуммаПозиций + Позиция.Сумма;
		КонецЕсли;
	КонецЦикла;
	СуммаОплат = 0;
	Для Каждого Оплата Из ДанныеПробития.ТаблицаОплат Цикл
		СуммаОплат = СуммаОплат + Оплата.Сумма;
	КонецЦикла;
	Сводка = СтрШаблон("образец %1; товары %2, оплаты документа %3, наличными %4, документ %5; в чеке БПО позиции %6, оплаты %7",
		Образец, Чек.Товары.Итог("Сумма"), Чек.Оплата.Итог("Сумма"), Чек.ВыручкаНаличными, Чек.СуммаДокумента, СуммаПозиций, СуммаОплат);
	Возврат Новый Структура("Ссылка, Параметры, Сводка", Чек.Ссылка, ДанныеПробития, Сводка);
КонецФункции

// БПО 3.3 ведёт кассовые смены в базе (в УНФ — документ «Кассовая смена» с «Фискальным устройством»)
// и не открывает смену, пока считает прежнюю открытой. После сброса эмулятора (смена на ККТ закрыта)
// смену прошлого прогона закрываем и в базе — только в тестовой копии.
&НаСервереБезКонтекста
Функция ЗакрытьВисящуюСменуБПО(ККТ)
	Смена = Метаданные.Документы.Найти("КассоваяСмена");
	Если Смена = Неопределено Или Смена.Реквизиты.Найти("ФискальноеУстройство") = Неопределено Тогда
		Возврат "учёта смен в базе нет (БПО 3.2)";
	КонецЕсли;
	Если СтрНайти(СтрокаСоединенияИнформационнойБазы(), "EmulkonTest") = 0 Тогда
		Возврат "не трогаем: это не тестовая копия EmulkonTest";
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос("ВЫБРАТЬ С.Ссылка КАК Ссылка ИЗ Документ.КассоваяСмена КАК С
	|ГДЕ С.ФискальноеУстройство = &ККТ И С.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыКассовойСмены.Открыта) И НЕ С.ПометкаУдаления");
	Запрос.УстановитьПараметр("ККТ", ККТ);
	Закрыто = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Объект = Выборка.Ссылка.ПолучитьОбъект();
		Объект.Статус = Перечисления["СтатусыКассовойСмены"]["Закрыта"];
		Объект.ОкончаниеКассовойСмены = ТекущаяДатаСеанса();
		Объект.Комментарий = "ЭМУЛКОН ТЕСТ: закрыта после сброса эмулятора";
		Объект.Записать(РежимЗаписиДокумента.Проведение);
		Закрыто.Добавить(Строка(Выборка.Ссылка));
	КонецЦикла;
	Возврат ?(Закрыто.Количество() = 0, "открытых нет", "закрыто: " + СтрСоединить(Закрыто, ", "));
КонецФункции

// «Чек ККМ» УНФ: у документа есть «Кассовая смена», у розничных продаж — открытие кассовой смены.
&НаСервереБезКонтекста
Функция ЕстьЧекККМУНФ()
	// Только УНФ и Розница 3.0 (на УНФ): у УТ 11 и КА 2 «Чек ККМ» свой, раздел к ним не подходит.
	Если Метаданные.Имя <> "УправлениеНебольшойФирмой" И Метаданные.Имя <> "Розница" Тогда
		Возврат Ложь;
	КонецЕсли;
	Документ = Метаданные.Документы.Найти("ЧекККМ");
	Возврат Документ <> Неопределено И Документ.Реквизиты.Найти("КассоваяСмена") <> Неопределено
		И Метаданные.Документы.Найти("КассоваяСмена") <> Неопределено
		И Метаданные.ОбщиеМодули.Найти("РозничныеПродажиСервер") <> Неопределено;
КонецФункции

// Образец — проведённый пробитый чек продажи за наличные (без безнала, предоплаты, акцизных марок, подарков).
&НаСервереБезКонтекста
Функция ОбразецЧекаУНФ()
	// Каждый прогон продаёт копию образца: товар на складе кассы кончается, и чек не проводится
	// («Не хватает остатка»). Берём образец, по всем строкам которого остаток ещё есть.
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ч.Ссылка КАК Ссылка ИЗ Документ.ЧекККМ КАК Ч
	|ГДЕ Ч.Проведен
	|	И НЕ Ч.ОперацияСДенежнымиСредствами И НЕ Ч.Комментарий ПОДОБНО ""ЭМУЛКОН ТЕСТ%""
	|	И НЕ Ч.Ссылка В (ВЫБРАТЬ Б.Ссылка ИЗ Документ.ЧекККМ.БезналичнаяОплата КАК Б)
	|	И НЕ Ч.Ссылка В (ВЫБРАТЬ П.Ссылка ИЗ Документ.ЧекККМ.Предоплата КАК П)
	|	И НЕ Ч.Ссылка В (ВЫБРАТЬ А.Ссылка ИЗ Документ.ЧекККМ.АкцизныеМарки КАК А)
	|	И НЕ Ч.Ссылка В (ВЫБРАТЬ Д.Ссылка ИЗ Документ.ЧекККМ.Подарки КАК Д)
	|	И НЕ Ч.Ссылка В (ВЫБРАТЬ З.Ссылка ИЗ Документ.ЧекККМ.Запасы КАК З
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.Запасы.Остатки КАК О
	|		ПО О.Номенклатура = З.Номенклатура И О.Характеристика = З.Характеристика
	|			И О.СтруктурнаяЕдиница = З.Ссылка.СтруктурнаяЕдиница
	|		СГРУППИРОВАТЬ ПО З.Ссылка, З.НомерСтроки, З.Количество
	|		ИМЕЮЩИЕ ЕСТЬNULL(СУММА(О.КоличествоОстаток), 0) < З.Количество)
	|УПОРЯДОЧИТЬ ПО Ч.Дата УБЫВ");
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Всего,
		|	СУММА(ВЫБОР КОГДА Ч.Проведен ТОГДА 1 ИНАЧЕ 0 КОНЕЦ) КАК Проведено,
		|	СУММА(ВЫБОР КОГДА Ч.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЧековККМ.Пробит) ТОГДА 1 ИНАЧЕ 0 КОНЕЦ) КАК Пробито,
		|	СУММА(ВЫБОР КОГДА Ч.Архивный ТОГДА 1 ИНАЧЕ 0 КОНЕЦ) КАК Архивных
		|ИЗ Документ.ЧекККМ КАК Ч;
		|ВЫБРАТЬ КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Б.Ссылка) КАК СБезналом ИЗ Документ.ЧекККМ.БезналичнаяОплата КАК Б");
		Пакет = Запрос.ВыполнитьПакет();
		Счетчики = Пакет[0].Выбрать();
		Счетчики.Следующий();
		ВызватьИсключение СтрШаблон("нет образца «Чек ККМ»: всего %1, проведено %2, пробито %3, архивных %4, с безналом %5",
			Счетчики.Всего, Счетчики.Проведено, Счетчики.Пробито, Счетчики.Архивных, Пакет[1].Выгрузить()[0].СБезналом);
	КонецЕсли;
	Возврат Выборка.Ссылка;
КонецФункции

// Касса образца, переключённая на ККТ Эмулкона (тестовая копия базы).
&НаСервереБезКонтекста
Функция КассаУНФСККТ(ККТ)
	УстановитьПривилегированныйРежим(Истина);
	Касса = ОбразецЧекаУНФ().КассаККМ.ПолучитьОбъект();
	Касса.ПодключаемоеОборудование = ККТ;
	Касса.ИспользоватьБезПодключенияОборудования = Ложь;
	Касса.Записать();
	Возврат Касса.Ссылка;
КонецФункции

&НаСервереБезКонтекста
Функция КассоваяСменаУНФ(Касса, Открыть)
	УстановитьПривилегированныйРежим(Истина);
	Модуль = ОбщегоНазначения.ОбщийМодуль("РозничныеПродажиСервер");
	ОписаниеОшибки = "";
	Если Открыть Тогда
		Результат = Модуль.ОткрытьКассовуюСмену(Касса, ОписаниеОшибки);
	Иначе
		Результат = Модуль.ЗакрытьКассовуюСмену(Касса, ОписаниеОшибки);
	КонецЕсли;
	Состояние = Модуль.ПолучитьСостояниеКассовойСмены(Касса);
	Возврат Новый Структура("Результат, Описание", Результат = Истина,
		?(ЗначениеЗаполнено(ОписаниеОшибки), ОписаниеОшибки + "; ", "") + Строка(Состояние.КассоваяСмена) + ": " + Состояние.СтатусКассовойСмены);
КонецФункции

&НаСервереБезКонтекста
Функция ПодготовитьЧекУНФ(Касса)
	УстановитьПривилегированныйРежим(Истина);
	Образец = ОбразецЧекаУНФ();
	Чек = Образец.Скопировать();
	Чек.Дата = ТекущаяДатаСеанса();
	Чек.КассаККМ = Касса;
	Чек.КассоваяСмена = ОбщегоНазначения.ОбщийМодуль("РозничныеПродажиСервер").ПолучитьСостояниеКассовойСмены(Касса).КассоваяСмена;
	Чек.Статус = Перечисления["СтатусыЧековККМ"]["Пробит"];
	Чек.НомерЧекаККМ = 0;
	Чек.НомерСменыККМ = 0;
	Чек.Архивный = Ложь;
	Чек.Комментарий = "ЭМУЛКОН ТЕСТ: копия " + Образец;
	Если Чек.ПолученоНаличными = 0 Тогда
		Чек.ПолученоНаличными = Образец.ПолученоНаличными;
	КонецЕсли;
	Чек.Записать(РежимЗаписиДокумента.Запись);
	// Менеджер документа ждёт данные формы (Свойство(), таблицы) — подаём их структурой.
	ДанныеДокумента = Новый Структура("Ссылка, Дата, Номер, Проведен, ПометкаУдаления",
		Чек.Ссылка, Чек.Дата, Чек.Номер, Чек.Проведен, Чек.ПометкаУдаления);
	Для Каждого Реквизит Из Чек.Метаданные().Реквизиты Цикл
		ДанныеДокумента.Вставить(Реквизит.Имя, Чек[Реквизит.Имя]);
	КонецЦикла;
	Для Каждого Таблица Из Чек.Метаданные().ТабличныеЧасти Цикл
		ДанныеДокумента.Вставить(Таблица.Имя, Чек[Таблица.Имя]); // табличная часть: Выгрузить(), Количество()
	КонецЦикла;
	ДанныеПробития = Документы["ЧекККМ"].ПодготовитьДанныеДляПробитияЧека(ДанныеДокумента, Чек.Ссылка, Неопределено, Неопределено);
	ДанныеПробития.ДатаВремя = ТекущаяДатаСеанса();
	// У организации демо-базы УНФ нет названия и ИНН для чека — тогда реквизиты регистрации эмулятора.
	Если Не ЗначениеЗаполнено(ДанныеПробития.ОрганизацияНазвание) Тогда
		ДанныеПробития.ОрганизацияНазвание = "ООО «ТЕСТ ЭМУЛКОН»";
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ДанныеПробития.ОрганизацияИНН) Тогда
		ДанныеПробития.ОрганизацияИНН = "7700000000";
	КонецЕсли;
	Сводка = СтрШаблон("образец %1; запасы %2, наличными %3, документ %4; касса %5, смена %6",
		Образец, Чек.Запасы.Итог("Сумма"), Чек.ПолученоНаличными, Чек.СуммаДокумента, Касса, Чек.КассоваяСмена);
	Возврат Новый Структура("Ссылка, Параметры, Сводка", Чек.Ссылка, ДанныеПробития, Сводка);
КонецФункции

&НаСервереБезКонтекста
Функция ЗаписатьЧекУНФ(Ссылка, НомерСмены, НомерЧека)
	УстановитьПривилегированныйРежим(Истина);
	Чек = Ссылка.ПолучитьОбъект();
	Чек.НомерСменыККМ = НомерСмены;
	Чек.НомерЧекаККМ = ?(ЗначениеЗаполнено(НомерЧека), НомерЧека, 1);
	Чек.Дата = ТекущаяДатаСеанса();
	ПолучитьСообщенияПользователю(Истина);
	Попытка
		Чек.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		// Причину непроведения (остатки, реквизиты) УНФ пишет сообщениями — в отчёт вместе с ошибкой.
		Причины = Новый Массив;
		Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
			Причины.Добавить(Сообщение.Текст);
		КонецЦикла;
		ВызватьИсключение КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + "; " + СтрСоединить(Причины, "; ");
	КонецПопытки;
	Возврат "документ " + ?(Ссылка.Проведен, "проведён", "НЕ проведён") + ", статус «" + Ссылка.Статус + "», сумма " + Ссылка.СуммаДокумента;
КонецФункции

// Документ «Чек ККМ» и розничные продажи — объекты Розницы; в других конфигурациях раздела нет.
&НаСервереБезКонтекста
Функция ЕстьЧекККМРозницы()
	// Розница 3.0 построена на УНФ: у её «Чека ККМ» есть «Кассовая смена» — это раздел УНФ.
	Возврат Метаданные.Имя = "Розница" И Метаданные.Документы.Найти("ЧекККМ") <> Неопределено
		И Метаданные.Документы.ЧекККМ.Реквизиты.Найти("КассоваяСмена") = Неопределено
		И Метаданные.Справочники.Найти("КассыККМ") <> Неопределено
		И Метаданные.ОбщиеМодули.Найти("РозничныеПродажиСервер") <> Неопределено;
КонецФункции

&НаСервереБезКонтекста
Функция СостояниеЧекаРМК(Ссылка)
	Возврат "документ " + ?(Ссылка.Проведен, "проведён", "НЕ проведён") + ", статус «" + Ссылка.СтатусЧекаККМ
		+ "», сумма " + Ссылка.СуммаДокумента;
КонецФункции

// Параметры экземпляра целиком, как их сохраняет форма «Настройка» БПО. Токен и рабочее место
// меняет раздел «Токен рабочего места».
&НаСервереБезКонтекста
Процедура ЗаписатьПараметрыСвязи(Ссылка, Тип, Сервер, РабочееМестоЭмулятора, Токен, База = Неопределено)
	УстановитьПривилегированныйРежим(Истина);
	Имя = Ссылка.Наименование;
	Настройки = Новый Структура;
	Настройки.Вставить("P_ServerURL", Сервер);
	Настройки.Вставить("P_DeviceToken", Токен);
	Настройки.Вставить("P_WorkstationID", РабочееМестоЭмулятора);
	Настройки.Вставить("P_TimeoutMs", 30000);
	Настройки.Вставить("P_AutoUpdate", Ложь);
	// Экземпляр в 1С (ARCHITECTURE §4.3) — как его будет заполнять обработка-помощник:
	// идентификатор — GUID ссылки, наименование и база.
	Настройки.Вставить("P_InstanceID", Строка(Ссылка.УникальныйИдентификатор()));
	Настройки.Вставить("P_InstanceName", Имя);
	Настройки.Вставить("P_Infobase", ?(База = Неопределено, ИмяБазы(), База));
	Если Тип = "СчитывательМагнитныхКарт" Тогда
		Дорожки = Новый Массив;
		Для Номер = 1 По 3 Цикл
			Дорожки.Добавить(Новый Структура("НомерДорожки, Использовать, Префикс, Суффикс", Номер, Номер = 2, 0, ?(Номер = 2, 13, 0)));
		КонецЦикла;
		Настройки.Вставить("ПараметрыДорожек", Дорожки);
		Настройки.Вставить("P_Prefix", 0);
		Настройки.Вставить("P_Suffix", 13);
	КонецЕсли;
	Если Не МенеджерОборудования.СохранитьПараметрыУстройства(Ссылка, Настройки) Тогда
		ВызватьИсключение "не записаны параметры устройства «" + Имя + "»";
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьОтчет()
	Путь = ?(Запуск = Неопределено, КаталогВременныхФайлов() + "emulkon-1c-report.txt", Запуск.report);
	Текст = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
	Для Каждого Строка Из Отчет Цикл
		Текст.ЗаписатьСтроку(Строка);
	КонецЦикла;
	Текст.Закрыть();
КонецПроцедуры

#КонецОбласти
