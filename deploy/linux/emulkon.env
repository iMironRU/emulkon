# Настройки сервера Эмулкон (переменные окружения службы emulkon). После правки:
#   sudo systemctl restart emulkon
# Файл читает только root (права 0600): здесь могут быть хеши токенов. Все настройки — в server/cmd/emulkon/main.go.

# Адрес HTTP. Только этот компьютер — 127.0.0.1:8737; кассы в сети — 0.0.0.0:8737 (и откройте порт в брандмауэре).
EMULKON_ADDR=127.0.0.1:8737

# Пакеты драйвера для страницы /downloads и самообновления драйверов (пакет кладёт их сюда).
EMULKON_DOWNLOADS_DIR=/usr/share/emulkon/driver

# Токены: SHA-256 токена (64 шестнадцатеричных символа), не сам токен. Хеш: printf '%s' 'emk_…' | sha256sum
# Без токена управления Control API и веб-интерфейс открыты всем, кто достучится до адреса.
#EMULKON_CONTROL_TOKEN_HASH=
#EMULKON_DEVICE_TOKEN_HASH=

# debug | info | warn | error
EMULKON_LOG_LEVEL=info

# Новые выпуски: notify — раз в сутки сообщать (журнал, веб-интерфейс), off — не проверять. Пакет обновляют apt/dnf.
#EMULKON_UPDATE_MODE=notify
