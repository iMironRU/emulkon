// Ресурсы установщика: значок, версия и полезная нагрузка — файлы, которые он ставит.
// PAYLOAD_DIR собирает setup/build.ps1 (путь латиницей). Без windows.h: константы числами.
1 ICON "@PAYLOAD_DIR@/emulkon.ico"

SERVER RCDATA "@PAYLOAD_DIR@/emulkon.exe"
TRAY RCDATA "@PAYLOAD_DIR@/EmulkonTray.exe"
DRIVERZIP RCDATA "@PAYLOAD_DIR@/EmulkonDriver_@PROJECT_VERSION@.zip"
DRIVER64 RCDATA "@PAYLOAD_DIR@/EmulkonDriver_@PROJECT_VERSION@_win64.dll"
DRIVER32 RCDATA "@PAYLOAD_DIR@/EmulkonDriver_@PROJECT_VERSION@_win32.dll"
SNAPIN RCDATA "@PAYLOAD_DIR@/EmulkonSnapIn.dll"
@LINUX_DRIVER_RC@

1 VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041904b0"
        BEGIN
            VALUE "CompanyName", "imiron.ru"
            VALUE "FileDescription", "Emulkon Setup: 1C BPO equipment emulator (server, tray, driver)"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "EmulkonSetup"
            VALUE "OriginalFilename", "EmulkonSetup.exe"
            VALUE "ProductName", "Emulkon"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x419, 1200
    END
END
